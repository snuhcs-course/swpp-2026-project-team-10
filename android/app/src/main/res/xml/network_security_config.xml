<?xml version="1.0" encoding="utf-8"?>
<!--
    No server has TLS (Design AD-11), so plain http:// and ws:// are allowed to the one host a release build uses,
    the AWS server, and to nothing else. Debug builds replace this file with src/debug/res/xml/.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">3.105.185.251</domain>
    </domain-config>
</network-security-config>
