<?xml version="1.0" encoding="utf-8"?>
<!-- The Guide button: a glass circle with a guide-colored ring once a guide is on the camera (activated). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#1FFFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_activated="true">
                <shape android:shape="oval">
                    <solid android:color="@color/pix_surface_2" />
                    <stroke android:width="1.5dp" android:color="@color/pix_guide_stroke" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/pix_surface_2" />
                    <stroke android:width="1dp" android:color="@color/pix_glass_stroke" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
