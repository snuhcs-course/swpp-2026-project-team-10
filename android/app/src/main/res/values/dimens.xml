<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Generating poses: the space around each slot of the 2×2 grid (CandidateGridFit). -->
    <dimen name="pose_card_margin">6dp</dimen>
    <!-- Pick a pose: how much of the next and the previous candidate shows at the sides, and the gap between them. -->
    <dimen name="pose_page_peek">28dp</dimen>
    <dimen name="pose_page_gap">12dp</dimen>
    <!-- The camera bars' last part, over the image (TOP_BAR_OVERHANG_DP): what is in the bar centers above it. -->
    <dimen name="top_bar_overhang">4dp</dimen>
    <!-- The top bar buttons' pill, 32 dp of the bar's 52: what is left above and below it, 4 dp more below for the
         overhang, so it centers on the bar's line. -->
    <dimen name="top_bar_pill_inset_top">8dp</dimen>
    <dimen name="top_bar_pill_inset_bottom">12dp</dimen>
    <!-- The pose flow's bar under the top bar (R&S 6.3, #210). -->
    <dimen name="flow_progress_height">3dp</dimen>
    <!-- The camera's top bar during the scene photo (R&S 6.3, #210): Back 8 dp in, as a header's Back 12 dp past its
         20 dp padding, and the menu and the ratio ending at the 20 dp where a header's action ends. -->
    <dimen name="scene_bar_start">8dp</dimen>
    <dimen name="scene_bar_end">20dp</dimen>
    <!-- Between the situations' tiles on Add a pose guide (FR-4.8). -->
    <dimen name="situation_tile_gap">8dp</dimen>
    <!-- A thumbnail of the photo viewer's strip takes taps on 48 dp (NFR-16, item_photo_thumb). -->
    <dimen name="photo_thumb_touch">48dp</dimen>
    <!-- Generate poses' description field (FR-4.15): each line of its text, and of the hint that says Auto, so the field
         is as high with one as with the other. -->
    <dimen name="description_line_height">20sp</dimen>
</resources>
