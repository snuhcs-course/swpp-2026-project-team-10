<?xml version="1.0" encoding="utf-8"?>
<!-- The sign-up agreement (FR-5.19), before any account is made: the three required consents (14 or older, collection
     and use, transfer abroad), each with its own box and the last two with their details, Agree to all, and the full
     privacy policy. Agree and continue waits for all three. As Sign up's first page it opens the form; as Sign up with
     Google, after "Do you already have a Pix account?" answered No, it makes the account, and Pix ID setup comes next.
     SignUpAgreement sets the header and the details. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp">

            <ImageButton
                android:id="@+id/backButton"
                style="@style/Widget.Pix.Header.Back"
                android:contentDescription="@string/back" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:accessibilityHeading="true"
                android:text="@string/sign_up_title"
                android:textAppearance="@style/TextAppearance.Pix.Header" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/sign_up_consent_title"
            android:textAppearance="@style/TextAppearance.Pix.Title"
            android:textColor="@color/pix_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_list_card"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/allCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:minHeight="56dp"
                android:paddingStart="8dp"
                android:text="@string/sign_up_consent_all"
                android:textAppearance="@style/TextAppearance.Pix.Header"
                android:textColor="@color/pix_text" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:background="@color/pix_outline" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/ageCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="56dp"
                android:minHeight="48dp"
                android:paddingStart="8dp"
                android:textAppearance="@style/TextAppearance.Pix.Body"
                android:textColor="@color/pix_text_soft" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/collectionCheck"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:paddingStart="8dp"
                    android:textAppearance="@style/TextAppearance.Pix.Body"
                    android:textColor="@color/pix_text_soft" />

                <ImageButton
                    android:id="@+id/collectionToggle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:rotation="90"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/pix_text_faint" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/collectionDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_consent_details"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="9dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/collectionRefusal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/sign_up_consent_refusal"
                    android:textAppearance="@style/TextAppearance.Pix.Body.Small"
                    android:textColor="@color/pix_text_muted" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/transferCheck"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:paddingStart="8dp"
                    android:textAppearance="@style/TextAppearance.Pix.Body"
                    android:textColor="@color/pix_text_soft" />

                <ImageButton
                    android:id="@+id/transferToggle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:rotation="90"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/pix_text_faint" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/transferDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_consent_details"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="9dp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:background="@color/pix_outline" />

            <include
                android:id="@+id/policyRow"
                layout="@layout/item_setting_row" />
        </LinearLayout>

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.Pix.Body"
            android:textColor="@color/pix_danger_text"
            android:visibility="gone" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <Button
            android:id="@+id/agreeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/sign_up_consent_continue" />
    </LinearLayout>
</ScrollView>
