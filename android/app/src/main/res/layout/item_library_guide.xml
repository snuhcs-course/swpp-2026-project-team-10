<?xml version="1.0" encoding="utf-8"?>
<!-- One guide in the library (FR-3.11): its thumbnail at 3:4, the icon of its kind, a photo or an AI pose, and a ♥ that
     adds it to Favorites (#297); while selecting, its mark at the top left; the memo button at its top right (#270); and
     under it, the situation a pose was made for and the memo, each only when the guide has one. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/thumbnail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/pix_surface_2"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:padding="0.5dp"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Pix.Thumbnail"
        app:strokeColor="@color/pix_glass_stroke"
        app:strokeWidth="1dp" />

    <ImageView
        android:id="@+id/kindIcon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_margin="8dp"
        android:background="@drawable/bg_kind_badge"
        android:importantForAccessibility="no"
        android:padding="6dp"
        app:layout_constraintBottom_toBottomOf="@id/thumbnail"
        app:layout_constraintStart_toStartOf="@id/thumbnail"
        app:tint="@color/pix_text" />

    <!-- While selecting (#297): whether the guide is selected, a ring or the accent's check, at the top left. -->
    <ImageView
        android:id="@+id/selectMark"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_margin="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_select_off"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/thumbnail"
        app:layout_constraintTop_toTopOf="@id/thumbnail" />

    <!-- The ♥ (#297): empty, or red for a favorite, beside the kind's icon; a tap adds the guide to Favorites or takes
         it out. Takes taps on 48 dp (NFR-16) and draws the kind icon's 26 dp disc at its middle; hidden while selecting. -->
    <ImageButton
        android:id="@+id/favoriteButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="-7dp"
        android:layout_marginBottom="-11dp"
        android:background="@drawable/bg_favorite_button"
        android:padding="17dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_heart"
        app:layout_constraintBottom_toBottomOf="@id/kindIcon"
        app:layout_constraintStart_toEndOf="@id/kindIcon" />

    <!-- Takes taps on 48 dp (NFR-16) and draws the kind icon's 26 dp disc at its middle. -->
    <ImageButton
        android:id="@+id/memoButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="-3dp"
        android:layout_marginEnd="-3dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/library_memo_edit"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_memo_badge"
        app:layout_constraintEnd_toEndOf="@id/thumbnail"
        app:layout_constraintTop_toTopOf="@id/thumbnail" />

    <TextView
        android:id="@+id/situationText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Pix.Caption"
        android:textColor="@color/pix_text_faint"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/thumbnail"
        app:layout_constraintStart_toStartOf="@id/thumbnail"
        app:layout_constraintTop_toBottomOf="@id/thumbnail" />

    <TextView
        android:id="@+id/memoText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Pix.Body.Small"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/thumbnail"
        app:layout_constraintStart_toStartOf="@id/thumbnail"
        app:layout_constraintTop_toBottomOf="@id/situationText" />
</androidx.constraintlayout.widget.ConstraintLayout>
