<?xml version="1.0" encoding="utf-8"?>
<!-- Subject view (R&S 6.6, FR-6.6, FR-6.7, FR-7.1). No shutter: only the photographer takes photos. A pinch on
     the video zooms the photographer's camera while guide-edit mode is off (AD-17). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- "<name>'s camera" with the name from hello (FR-6.6). -->
        <TextView
            android:id="@+id/photographerName"
            style="@style/Widget.Pix.Chip.Live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/subject_title_placeholder"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/leaveButton"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/leaveButton"
            style="@style/Widget.Pix.Button.Glass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/leave"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/pix_ground"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <!-- The photographer's live video, the whole frame in the ratio they chose (Design 2.6.4, AD-10). It wraps
             its content so that it measures itself to the video's shape and is centered, the same rectangle the
             grid and the guide fit; at match_parent the renderer would crop every frame to the view's shape. -->
        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/liveView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <!-- The same 3×3 grid as the photographer's preview, over the same fitted image; no level bar here. -->
        <com.lastpenguin.pix.ui.camera.CameraCompositionView
            android:id="@+id/compositionOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <!-- "Connecting…" until the peer connection is up, or "camera paused" when frames stop. -->
        <TextView
            android:id="@+id/connectingText"
            style="@style/Widget.Pix.Chip"
            android:layout_gravity="center"
            android:accessibilityLiveRegion="polite"
            android:text="@string/connecting" />

        <!-- The synced guide (#9). Editable only while guide-edit mode is on; moving it is #57. -->
        <com.lastpenguin.pix.guide.GuideOverlayView
            android:id="@+id/guideOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            app:drawableStartCompat="@drawable/ic_zoom_small"
            android:drawablePadding="8dp"
            app:drawableTint="@color/pix_text_muted"
            android:gravity="center"
            android:text="@string/subject_caption"
            android:textAppearance="@style/TextAppearance.Pix.Body.Small"
            android:textColor="@color/pix_text_soft" />

        <!-- The Camera screen's zoom readout, enabled while connected (FR-7.1), and the guide-edit mode toggle. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/zoomReadout"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_zoom_readout"
                android:focusable="true"
                android:gravity="center"
                android:importantForAccessibility="yes"
                android:minWidth="56dp"
                android:paddingHorizontal="12dp"
                android:textAppearance="@style/TextAppearance.Pix.Label.Bold"
                android:textColor="@color/zoom_readout_text"
                android:textSize="14sp"
                tools:text="1.0×" />

            <!-- Shown while a guide is on the video (AD-17); checked while gestures edit the guide. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/editGuideButton"
                style="@style/Widget.Pix.Button.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:layout_gravity="end|center_vertical"
                android:contentDescription="@string/edit_guide"
                android:visibility="gone"
                app:backgroundTint="@color/edit_guide_background"
                app:icon="@drawable/ic_move"
                app:iconTint="@color/edit_guide_icon"
                tools:visibility="visible" />
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
