<?xml version="1.0" encoding="utf-8"?>
<!-- The session's photos (FR-1.6, FR-6.14; R&S 6.5, 6.6), over Camera on the photographer's phone and over Subject view
     on the subject's: each whole, one page each, opened at the newest, under a header with Back alone, no title, and
     which one of how many below. It covers the screen inside Pix, so the session and its video go on under it; the phone's gallery would
     put Pix in the background. It takes every touch, so none reaches the screen under it; its holder keeps it above all of
     the screen. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/photoViewer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/camera_bar"
    android:clickable="true"
    android:focusable="false"
    android:importantForAccessibility="no"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:id="@+id/photoViewerHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/photoViewerBack"
            style="@style/Widget.Pix.Header.Back"
            android:contentDescription="@string/back" />
    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/photoViewerPages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/photoViewerCounter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/photoViewerHeader"
        tools:listitem="@layout/item_photo_page" />

    <!-- Kept in place while there is one photo, so a second one coming does not move the photo on screen. -->
    <TextView
        android:id="@+id/photoViewerCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:textAppearance="@style/TextAppearance.Pix.Label.Bold"
        android:textColor="@color/pix_text_faint"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="2 / 3"
        tools:visibility="visible" />
</androidx.constraintlayout.widget.ConstraintLayout>
