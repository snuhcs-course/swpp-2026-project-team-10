<?xml version="1.0" encoding="utf-8"?>
<!-- The applied zoom over the bottom of the camera's image: translucent glass, like the chips over it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="@color/pix_glass" />
            <stroke android:width="1dp" android:color="@color/pix_glass_stroke" />
        </shape>
    </item>
</selector>
