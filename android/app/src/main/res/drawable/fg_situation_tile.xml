<?xml version="1.0" encoding="utf-8"?>
<!-- Over a situation's tile on Add a pose guide (FR-4.8): a hairline edge. SituationTiles draws the press, so no ripple
     shows over its dimming (#243). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="@color/pix_hairline" />
</shape>
