<?xml version="1.0" encoding="utf-8"?>
<!-- A menu that opens from a header's ⋮, such as the library's (#297): a card of the screens' surfaces, rounded as their
     cards are, with a hairline that sets it off from the photos under it. Its shape is the popup's outline, so the
     shadow follows the corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="@color/pix_surface_2" />
    <stroke
        android:width="1dp"
        android:color="@color/pix_glass_stroke" />
</shape>
