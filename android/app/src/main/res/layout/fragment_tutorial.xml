<?xml version="1.0" encoding="utf-8"?>
<!-- The first-use tutorial over a screen (FR-10.4): the dimming, the rings, and the captions, which CoachMarkLayout adds
     and places, and the line saying a tap anywhere closes it, which it keeps at the bottom's middle. -->
<com.lastpenguin.pix.ui.settings.CoachMarkLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tutorialCloseHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/tutorial_close_hint"
        android:textAppearance="@style/TextAppearance.Pix.Caption"
        android:textSize="11sp" />
</com.lastpenguin.pix.ui.settings.CoachMarkLayout>
