<?xml version="1.0" encoding="utf-8"?>
<!-- Shared by the failure screens: what happened, a retry, and a way back (R&S 6.9). The pose and guide failures put
     them in the top bar, Back at the top left and the retry at the top right (#199); the session's keep the two
     buttons at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="20dp">

    <!-- Shown by showFailureTopBar; its action hides when the failure has no retry. -->
    <LinearLayout
        android:id="@+id/failureTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageButton
            android:id="@+id/backButton"
            style="@style/Widget.Pix.Header.Back"
            android:contentDescription="@string/back" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/topActionButton"
            style="@style/Widget.Pix.Button.Header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Try again" />
    </LinearLayout>

    <!-- 12 dp under the screen's top padding, and 8 dp under the top bar (showFailureTopBar). -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/failureCard"
        style="@style/Widget.Pix.Card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- The photo the failed request was about, for a screen that has one (R&S 6.3). -->
            <FrameLayout
                android:id="@+id/failurePhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/failurePhotoImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.3"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <TextView
                    style="@style/Widget.Pix.Chip"
                    android:layout_gravity="top|start"
                    android:layout_margin="12dp"
                    android:text="@string/your_photo" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:id="@+id/failureIcon"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_failure_icon"
                    android:importantForAccessibility="no"
                    android:padding="26dp"
                    android:src="@drawable/ic_alert"
                    app:tint="@color/pix_danger_text" />

                <TextView
                    android:id="@+id/failureTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:accessibilityHeading="true"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Pix.Title"
                    tools:text="No person found" />

                <TextView
                    android:id="@+id/failureMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.25"
                    android:textAppearance="@style/TextAppearance.Pix.BodyLarge"
                    tools:text="Pick a photo where one person is clearly visible." />
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <Button
        android:id="@+id/primaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        tools:text="Invite again" />

    <Button
        android:id="@+id/secondaryButton"
        style="@style/Widget.Pix.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        tools:text="Back to camera" />
</LinearLayout>
