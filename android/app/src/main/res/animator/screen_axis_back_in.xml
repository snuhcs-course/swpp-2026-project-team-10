<?xml version="1.0" encoding="utf-8"?>
<!-- The screen gone back to (Design 2.1, Material's shared axis along x): it comes 30 dp in from the left, fading in
     from 35 % of the transition on. -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <objectAnimator
        android:duration="@integer/screen_transition_ms"
        android:interpolator="@android:interpolator/fast_out_slow_in">
        <propertyValuesHolder
            android:propertyName="translationX"
            android:valueFrom="@dimen/screen_slide_back"
            android:valueTo="0dp"
            android:valueType="floatType" />
        <propertyValuesHolder
            android:propertyName="alpha"
            android:valueType="floatType">
            <keyframe
                android:fraction="0"
                android:value="0" />
            <keyframe
                android:fraction="0.35"
                android:value="0" />
            <keyframe
                android:fraction="1"
                android:value="1" />
        </propertyValuesHolder>
    </objectAnimator>
</set>
