<?xml version="1.0" encoding="utf-8"?>
<!-- A row inside a list card (bg_list_card) under a touch, such as a Settings row: the light 4 dp in from the card's
     sides and rounded 14 dp, inside the card's 18 dp corners, so it never shows past them. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">
    <item android:id="@android:id/mask">
        <inset
            android:insetLeft="4dp"
            android:insetRight="4dp">
            <shape android:shape="rectangle">
                <corners android:radius="14dp" />
                <solid android:color="@color/pix_text" />
            </shape>
        </inset>
    </item>
</ripple>
