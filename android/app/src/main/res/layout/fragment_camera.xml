<?xml version="1.0" encoding="utf-8"?>
<!-- Camera, Camera + guide, Photo saved, and the photographer's side of a session (R&S 6.2, 6.5). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:padding="12dp">

        <Button
            android:id="@+id/shootTogetherButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shoot_together" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- TODO(#3): replace with a PreviewView. -->
        <TextView
            android:id="@+id/previewPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#33333333"
            android:gravity="center"
            android:text="@string/camera_preview_placeholder" />

        <com.lastpenguin.pix.guide.GuideOverlayView
            android:id="@+id/guideOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Shown while a subject is connected (FR-6.8). -->
        <TextView
            android:id="@+id/liveBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_margin="12dp"
            android:visibility="gone"
            tools:text="Live · Junhyeong connected"
            tools:visibility="visible" />

        <!-- Remote action notice, such as "Junhyeong set zoom to 2×" (FR-7.4). -->
        <TextView
            android:id="@+id/noticeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_margin="12dp"
            android:visibility="gone"
            tools:text="Junhyeong set zoom to 2×"
            tools:visibility="visible" />
    </FrameLayout>

    <TextView
        android:id="@+id/zoomChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/zoom_chips_placeholder" />

    <!-- Shown while a guide is on the camera (R&S 6.2, Camera + guide). -->
    <LinearLayout
        android:id="@+id/guideControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <Button
            android:id="@+id/styleToggleButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/style_toggle" />

        <SeekBar
            android:id="@+id/opacitySlider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Button
            android:id="@+id/removeGuideButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/remove_guide" />
    </LinearLayout>

    <TextView
        android:id="@+id/hintText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/hint_add_guide" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="12dp">

        <Button
            android:id="@+id/guideButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/guide" />

        <Button
            android:id="@+id/shutterButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:text="@string/shutter" />

        <Button
            android:id="@+id/galleryButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gallery" />
    </LinearLayout>

    <!-- Shown while a subject is connected (FR-6.10). -->
    <Button
        android:id="@+id/endSessionButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/end_session"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
