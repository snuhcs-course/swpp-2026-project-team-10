<?xml version="1.0" encoding="utf-8"?>
<!-- Generate poses (R&S 6.3, FR-4.8), and the subject's (R&S 6.6): what to pose, asked before anything is sent. Back
     at the top left, the one button at the top right (#199). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp">

            <!-- Back to the scene photo's review (#199). -->
            <ImageButton
                android:id="@+id/backButton"
                style="@style/Widget.Pix.Header.Back"
                android:contentDescription="@string/back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/describe_title"
                android:textAppearance="@style/TextAppearance.Pix.Header" />

            <!-- The one button (Iter3-A13): Suggest with an empty field, Generate with a description (FR-4.4, FR-4.8,
                 US-5, #199). DescriptionForm sets its label as the field changes. -->
            <Button
                android:id="@+id/generateButton"
                style="@style/Widget.Pix.Button.Header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/suggest_poses" />
        </LinearLayout>

        <!-- The scene photo the poses are made from. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_info_card"
            android:gravity="center_vertical"
            android:padding="12dp">

            <!-- 72 dp high and as wide as the photo's shape (showScene): 54 dp for 3:4, 9:16 narrower, 1:1 square. -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/sceneImage"
                android:layout_width="54dp"
                android:layout_height="72dp"
                android:background="@color/pix_surface_2"
                android:contentDescription="@string/scene_photo_description"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Pix.SmallThumbnail" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/your_photo"
                    android:textAppearance="@style/TextAppearance.Pix.Action.Small"
                    android:textColor="@color/pix_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/generating_scene_caption"
                    android:textAppearance="@style/TextAppearance.Pix.Body.Small" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/descriptionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/describe_label"
            android:textAppearance="@style/TextAppearance.Pix.Action.Small"
            android:textColor="@color/pix_text" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <!-- Korean or English; input stops at 100 characters (FR-4.8). It wraps, and Done closes the keyboard. The
                 hint is its accessibility label, so the label above does not point at it (lint LabelFor). Its end
                 leaves room for the clear button. -->
            <EditText
                android:id="@+id/descriptionInput"
                style="@style/Widget.Pix.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/describe_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="100"
                android:paddingEnd="48dp" />

            <!-- ✕ empties the field while it holds text and is not waiting (Iter3-A13), so the one button asks for
                 suggested poses again; on the first line, in a 48 dp touch area. -->
            <ImageButton
                android:id="@+id/clearDescriptionButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|top"
                android:layout_marginTop="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/clear_description"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/pix_text_muted"
                tools:visibility="visible" />
        </FrameLayout>

        <!-- The counter stays at the end, under the field's right edge, with or without the message. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end">

            <!-- Shown after the service refused every pose of the description, for the photo or the text; the text is kept (US-5). -->
            <TextView
                android:id="@+id/descriptionError"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:text="@string/description_refused"
                android:textAppearance="@style/TextAppearance.Pix.Body.Small"
                android:textColor="@color/pix_danger_text"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/descriptionCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textAppearance="@style/TextAppearance.Pix.Caption"
                tools:text="0/100" />
        </LinearLayout>

        <!-- In a session: "Joonhyung is typing…" while the other phone's field holds the description (FR-6.15). -->
        <TextView
            android:id="@+id/descriptionTyping"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.Pix.Body.Small"
            android:textColor="@color/pix_accent"
            android:visibility="gone"
            tools:text="Joonhyung is typing…"
            tools:visibility="visible" />

        <!-- The descriptions used before (FR-4.11), hidden while there are none: the header with, in a session with a
             friend, the All / With <name> switch, then the entries as chips, newest first, each with a ✕. -->
        <LinearLayout
            android:id="@+id/historySection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/history_label"
                    android:textAppearance="@style/TextAppearance.Pix.Overline" />

                <!-- The whole history, or the one with the session's friend; gone without a friend (a room code, or
                     no session). The chosen half is selected. -->
                <LinearLayout
                    android:id="@+id/historyFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_segment_track"
                    android:padding="2dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <Button
                        android:id="@+id/historyAll"
                        style="@style/Widget.Pix.Button.Segment.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/history_all" />

                    <!-- A name may have 30 characters: cut short, so All stays on the screen beside it. -->
                    <Button
                        android:id="@+id/historyWithPartner"
                        style="@style/Widget.Pix.Button.Segment.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:maxWidth="160dp"
                        tools:text="With Joonhyung" />
                </LinearLayout>
            </LinearLayout>

            <!-- One item_history_chip per entry shown; a tap fills the field, which can then be edited. -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/historyChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="0dp" />

            <!-- With the friend chosen and nothing used with them yet. -->
            <TextView
                android:id="@+id/historyEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.Pix.Body.Small"
                android:visibility="gone"
                tools:text="Nothing used with Joonhyung yet"
                tools:visibility="visible" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <!-- In a session: the other phone shows this step too, and either one can write and go on (FR-6.15). -->
        <TextView
            android:id="@+id/sharedHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Pix.Body.Small"
            android:visibility="gone"
            tools:text="Joonhyung sees this too"
            tools:visibility="visible" />
    </LinearLayout>
</ScrollView>
