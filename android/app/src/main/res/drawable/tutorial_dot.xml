<?xml version="1.0" encoding="utf-8"?>
<!-- The tutorial's dots: the slide showing in the text's color, the others a step above the ground. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/pix_text" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/pix_surface_3" />
        </shape>
    </item>
</selector>
