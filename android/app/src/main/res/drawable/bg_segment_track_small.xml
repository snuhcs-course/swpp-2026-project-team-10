<?xml version="1.0" encoding="utf-8"?>
<!-- The track of a header's small switch (Widget.Pix.Button.Segment.Small): inset by the buttons' own 8 dp, so it hugs
     their 32 dp shapes while each takes taps on 48 dp (#298). -->
