<?xml version="1.0" encoding="utf-8"?>
<!-- Camera, Camera + guide, Photo saved, the scene photo for poses, and the photographer's side of a session
     (R&S 6.2, 6.3, 6.5). The 3:4 preview sits between the top bar and the controls, so only the transient chips
     and the guide's panel ever cover the photo. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Shown while a subject is connected (FR-6.8). -->
        <TextView
            android:id="@+id/liveBadge"
            style="@style/Widget.Pix.Chip.Live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/topBarActions"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Live · Junhyeong connected"
            tools:visibility="visible" />

        <!-- The title replaces Shoot together while the scene photo for poses is taken (R&S 6.3). -->
        <TextView
            android:id="@+id/sceneTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:accessibilityHeading="true"
            android:accessibilityLiveRegion="polite"
            android:text="@string/scene_title"
            android:textAppearance="@style/TextAppearance.Pix.Header"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/topBarActions"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/topBarActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:ignore="ButtonOrder"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <Button
                android:id="@+id/shootTogetherButton"
                style="@style/Widget.Pix.Button.Glass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shoot_together"
                app:icon="@drawable/ic_people" />

            <!-- Takes the place of Shoot together while a subject is connected (FR-6.10). -->
            <Button
                android:id="@+id/endSessionButton"
                style="@style/Widget.Pix.Button.Glass.Danger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/end_session"
                android:visibility="gone"
                tools:visibility="visible" />

            <Button
                android:id="@+id/sceneCancelButton"
                style="@style/Widget.Pix.Button.Glass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/pix_ground"
        android:splitMotionEvents="false"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/pix_ground" />

        <com.lastpenguin.pix.guide.GuideOverlayView
            android:id="@+id/guideOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.lastpenguin.pix.ui.camera.CameraCompositionView
            android:id="@+id/compositionOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="yes"
            android:visibility="invisible"
            tools:visibility="visible" />

        <ProgressBar
            android:id="@+id/cameraProgress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:contentDescription="@string/starting_camera"
            android:indeterminateTint="@color/pix_accent" />

        <!-- The scene photo that was taken, over the camera, until it is used or shot again (R&S 6.3). -->
        <ImageView
            android:id="@+id/sceneStill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/pix_ground"
            android:contentDescription="@string/scene_photo_description"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- Chips over the top of the preview: what just happened, then what to do. They pass touches through.
             The status chip fades in and out instead of making the hint jump. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:animateLayoutChanges="true"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Saving, Photo saved, or why a photo failed (FR-1.6). -->
            <TextView
                android:id="@+id/captureStatus"
                style="@style/Widget.Pix.Chip"
                android:layout_marginBottom="8dp"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone"
                tools:drawableStartCompat="@drawable/ic_check_circle_small"
                tools:text="@string/photo_saved"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/hintText"
                style="@style/Widget.Pix.Chip"
                app:drawableStartCompat="@drawable/ic_target_small"
                app:drawableTint="@color/pix_accent"
                android:text="@string/hint_add_guide" />
        </LinearLayout>

        <!-- Over the bottom of the preview: remote action notices, then the guide's controls. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Remote action notice, such as "Junhyeong set zoom to 2×" (FR-7.4). -->
            <TextView
                android:id="@+id/noticeText"
                style="@style/Widget.Pix.Chip"
                android:minHeight="40dp"
                android:visibility="gone"
                tools:text="Junhyeong set zoom to 2×"
                tools:visibility="visible" />

            <!-- Shown while a guide is on the camera (R&S 6.2, Camera + guide). -->
            <LinearLayout
                android:id="@+id/guideControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_glass_panel"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="2dp"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Cutout / Outline (FR-3.5); the chosen one is selected. -->
                <Button
                    android:id="@+id/cutoutSegment"
                    style="@style/Widget.Pix.Button.Segment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cutout" />

                <Button
                    android:id="@+id/outlineSegment"
                    style="@style/Widget.Pix.Button.Segment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:text="@string/outline" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/opacitySlider"
                    style="@style/Widget.Pix.Slider.Guide"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/guide_opacity"
                    android:enabled="false"
                    android:value="0.5"
                    android:valueFrom="0.1"
                    android:valueTo="0.9" />

                <TextView
                    android:id="@+id/opacityValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:importantForAccessibility="no"
                    android:minWidth="34dp"
                    android:textAppearance="@style/TextAppearance.Pix.Label.Bold"
                    tools:text="50%" />

                <Button
                    android:id="@+id/removeGuideButton"
                    style="@style/Widget.Pix.Button.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/remove_guide"
                    app:icon="@drawable/ic_close" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cameraMessagePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/pix_ground"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:background="@drawable/bg_icon_tile_large">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_camera_off" />
            </FrameLayout>

            <TextView
                android:id="@+id/cameraMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/camera_permission_message"
                android:textAppearance="@style/TextAppearance.Pix.BodyLarge" />

            <Button
                android:id="@+id/cameraActionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/open_settings" />

            <Button
                android:id="@+id/requestPermissionButton"
                style="@style/Widget.Pix.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/allow_camera"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <include
            android:id="@+id/zoomControls"
            layout="@layout/include_zoom_control" />

        <!-- Guide, shutter, and the last photo, in thirds and on one center line; the Guide label hangs below (R&S 6.2). -->
        <LinearLayout
            android:id="@+id/captureControls"
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/guideButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="24dp"
                    android:clickable="true"
                    android:contentDescription="@string/guide_add_description"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="8dp"
                    tools:ignore="UselessParent">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_guide_button"
                        android:duplicateParentState="true"
                        android:importantForAccessibility="no"
                        android:scaleType="center"
                        android:src="@drawable/ic_guide"
                        app:tint="@color/guide_button_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:layout_marginTop="6dp"
                        android:duplicateParentState="true"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:importantForAccessibility="no"
                        android:text="@string/guide"
                        android:textAppearance="@style/TextAppearance.Pix.Caption"
                        android:textColor="@color/pix_text_soft" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/shutterButton"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_shutter"
                    android:contentDescription="@string/shutter" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/galleryButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:background="@color/pix_surface_2"
                    android:clickable="true"
                    android:contentDescription="@string/open_last_photo"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="1dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/gallery_placeholder"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Pix.Thumbnail"
                    app:strokeColor="#B3FFFFFF"
                    app:strokeWidth="2dp" />
            </FrameLayout>
        </LinearLayout>

        <!-- Replaces the row above while the scene photo is confirmed (R&S 6.3). -->
        <LinearLayout
            android:id="@+id/sceneReviewControls"
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:visibility="gone"
            tools:ignore="ButtonStyle">

            <Button
                android:id="@+id/shootAgainButton"
                style="@style/Widget.Pix.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/shoot_again" />

            <Button
                android:id="@+id/usePhotoButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/use_this_photo" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
