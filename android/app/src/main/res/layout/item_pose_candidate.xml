<?xml version="1.0" encoding="utf-8"?>
<!-- One candidate of the 2×2 grid on Generating poses (R&S 6.3). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Pix.PoseCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/pose_card_margin">

    <!-- The cell has the scene photo's shape (PoseCandidateAdapter.frameAspect), also before its image arrives. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/poseImage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Pix.PoseImage"
            app:layout_constraintDimensionRatio="3:4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/poseImage"
            app:layout_constraintEnd_toEndOf="@id/poseImage"
            app:layout_constraintStart_toStartOf="@id/poseImage"
            app:layout_constraintTop_toTopOf="@id/poseImage">

            <ProgressBar
                android:id="@+id/poseProgress"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:indeterminateTint="@color/pix_text_faint" />

            <TextView
                android:id="@+id/poseStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textAppearance="@style/TextAppearance.Pix.Caption"
                android:textColor="@color/pix_text_faint"
                tools:text="Creating…" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
