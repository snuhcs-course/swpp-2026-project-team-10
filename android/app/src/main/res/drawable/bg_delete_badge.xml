<?xml version="1.0" encoding="utf-8"?>
<!-- The ✕ on a saved guide's thumbnail: a small dark disc inset in the 40 dp touch target. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="6dp">
    <shape android:shape="oval">
        <solid android:color="#B3000000" />
        <stroke
            android:width="1dp"
            android:color="@color/pix_glass_stroke" />
    </shape>
</inset>
