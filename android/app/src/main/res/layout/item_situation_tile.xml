<?xml version="1.0" encoding="utf-8"?>
<!-- One situation on Add a pose guide (FR-4.8): its drawing, which shows the framing, its name, and the occasions it
     suits. A tap chooses it; the chosen one has the accent edge and a check. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="124dp"
    android:layout_weight="1"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/fg_situation_tile">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/situationImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Pix.Thumbnail"
        tools:src="@drawable/situation_landmark" />

    <View
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_situation_label" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="8dp"
        android:importantForAccessibility="no"
        android:orientation="vertical">

        <TextView
            android:id="@+id/situationName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Pix.Label.Bold"
            android:textColor="@color/pix_text"
            android:textSize="14sp"
            tools:text="Landmark" />

        <TextView
            android:id="@+id/situationExample"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_marginTop="1dp"
            android:textAppearance="@style/TextAppearance.Pix.Body.Small"
            android:textColor="@color/pix_text_muted"
            android:textSize="11sp"
            tools:text="Sights, buildings" />
    </LinearLayout>

    <ImageView
        android:id="@+id/situationCheck"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="@drawable/bg_check_badge"
        android:importantForAccessibility="no"
        android:padding="4dp"
        android:src="@drawable/ic_check"
        android:visibility="gone"
        app:tint="@color/pix_on_accent"
        tools:visibility="visible" />
</FrameLayout>
