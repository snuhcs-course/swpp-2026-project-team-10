<?xml version="1.0" encoding="utf-8"?>
<!-- One candidate of the 2×2 grid on Generating poses and Pick a pose (R&S 6.3). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Material3.CardView.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:checkable="true"
    app:checkedIcon="@null"
    app:strokeColor="@color/pose_card_stroke">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- The cell keeps the camera frame's 3:4 shape before its image arrives. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/poseImage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="#33333333"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                app:layout_constraintDimensionRatio="3:4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="@id/poseImage"
                app:layout_constraintEnd_toEndOf="@id/poseImage"
                app:layout_constraintStart_toStartOf="@id/poseImage"
                app:layout_constraintTop_toTopOf="@id/poseImage">

                <ProgressBar
                    android:id="@+id/poseProgress"
                    android:layout_width="32dp"
                    android:layout_height="32dp" />

                <TextView
                    android:id="@+id/poseStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    tools:text="Creating…" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/poseLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            tools:text="Hands on hips" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
