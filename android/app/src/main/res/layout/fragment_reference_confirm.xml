<?xml version="1.0" encoding="utf-8"?>
<!-- Reference confirm (R&S 6.2), and the subject's Your reference (R&S 6.6): Back at the top left, Use at the top
     right (#199). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp">

        <ImageButton
            android:id="@+id/backButton"
            style="@style/Widget.Pix.Header.Back"
            android:contentDescription="@string/back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/reference_title"
            android:textAppearance="@style/TextAppearance.Pix.Header" />

        <!-- Puts the guide on the camera, once the person is found. -->
        <Button
            android:id="@+id/useGuideButton"
            style="@style/Widget.Pix.Button.Header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/use" />
    </LinearLayout>

    <!-- The outline over a neutral background (FR-2.3). Dark, so the light stroke stands out as it does on the camera. -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Pix.Card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/referenceImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/reference_preview_description"
                android:padding="20dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <!-- A screenshot cut to its photo (FR-2.10): the cut, then the kept photo in the bottom right corner. -->
            <com.lastpenguin.pix.ui.guide.ScreenshotCutView
                android:id="@+id/screenshotCut"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/kept_photo_description"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/referenceProgress"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/pix_accent"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="12dp"
                android:orientation="vertical">

                <!-- "Finding the person…" or "Person found". -->
                <TextView
                    android:id="@+id/referenceStatus"
                    style="@style/Widget.Pix.Chip"
                    android:accessibilityLiveRegion="polite"
                    app:drawableTint="@color/pix_live"
                    android:text="@string/finding_person"
                    android:textColor="@color/pix_text"
                    android:visibility="invisible"
                    tools:drawableStartCompat="@drawable/ic_person_check_small"
                    tools:visibility="visible" />

                <!-- "Joonhyung chose this pose" when the subject's pick brought the candidate here (FR-6.15). -->
                <TextView
                    android:id="@+id/chosenByText"
                    style="@style/Widget.Pix.Chip"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/pix_text"
                    android:visibility="gone"
                    tools:text="Joonhyung chose this pose"
                    tools:visibility="visible" />

                <!-- Only for a screenshot cut to its photo (FR-2.10). -->
                <TextView
                    android:id="@+id/cutChip"
                    style="@style/Widget.Pix.Chip"
                    android:layout_marginTop="8dp"
                    android:text="@string/cut_from_screenshot"
                    android:textColor="@color/pix_text"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_crop_small"
                    app:drawableTint="@color/pix_text"
                    tools:visibility="visible" />
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- In a session: the other phone shows this outline too, and the first Use decides (FR-6.15). -->
    <TextView
        android:id="@+id/sharedHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Pix.Body.Small"
        android:visibility="gone"
        tools:text="Joonhyung sees this guide too. The first to use it decides."
        tools:visibility="visible" />

    <!-- Makes the guide again from the whole screenshot (FR-2.10). -->
    <Button
        android:id="@+id/useWholeImageButton"
        style="@style/Widget.Pix.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/use_whole_image"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
