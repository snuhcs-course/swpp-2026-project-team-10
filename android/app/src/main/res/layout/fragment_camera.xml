<?xml version="1.0" encoding="utf-8"?>
<!-- Camera, Camera + guide, Photo saved, the scene photo for poses, and the photographer's side of a session
     (R&S 6.2, 6.3, 6.5). The preview fills the screen's width in the chosen aspect ratio: between the top bar and
     the controls when it fits there, and otherwise under them, the top bar first (previewArea, placed in code). The
     bars lie above it. The root tells the screen when a touch anywhere ends, which closes the pose tip (FR-4.10). -->
<com.lastpenguin.pix.ui.camera.TouchWatchingLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:outlineProvider="none"
        android:translationZ="1dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Flash (FR-1.12) and the aspect ratio (FR-1.13); each tap moves to the next choice. -->
        <LinearLayout
            android:id="@+id/cameraSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/flashButton"
                style="@style/Widget.Pix.Button.Icon.TopBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/flash_off"
                android:visibility="gone"
                app:icon="@drawable/ic_flash_off"
                tools:visibility="visible" />

            <Button
                android:id="@+id/aspectButton"
                style="@style/Widget.Pix.Button.Text.TopBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/aspect_4_3" />

        </LinearLayout>

        <!-- The title replaces Shoot together while the scene photo for poses is taken (R&S 6.3). -->
        <TextView
            android:id="@+id/sceneTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp"
            android:accessibilityHeading="true"
            android:accessibilityLiveRegion="polite"
            android:text="@string/scene_title"
            android:textAppearance="@style/TextAppearance.Pix.Header"
            android:textSize="14sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/topBarActions"
            app:layout_constraintStart_toEndOf="@id/cameraSettings"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginStart="0dp" />

        <LinearLayout
            android:id="@+id/topBarActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:ignore="ButtonOrder"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <Button
                android:id="@+id/shootTogetherButton"
                style="@style/Widget.Pix.Button.Glass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shoot_together"
                app:icon="@drawable/ic_people" />

            <!-- Takes the place of Shoot together while a subject is connected (FR-6.10). -->
            <Button
                android:id="@+id/endSessionButton"
                style="@style/Widget.Pix.Button.Glass.Danger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/end_session"
                android:visibility="gone"
                tools:visibility="visible" />

            <Button
                android:id="@+id/sceneCancelButton"
                style="@style/Widget.Pix.Button.Glass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="44dp"
        android:layout_marginBottom="152dp"
        android:background="@color/pix_ground"
        android:splitMotionEvents="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/pix_ground" />

        <!-- The last frame, held while the camera rebinds for a new ratio or lens (PreviewHold, Design 2.6.2, 2.6.5). -->
        <ImageView
            android:id="@+id/aspectStill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <com.lastpenguin.pix.guide.GuideOverlayView
            android:id="@+id/guideOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.lastpenguin.pix.ui.camera.CameraCompositionView
            android:id="@+id/compositionOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="yes"
            android:visibility="invisible"
            tools:visibility="visible" />

        <!-- Where a tap focused (FR-1.4); placed at the tap and faded out. -->
        <View
            android:id="@+id/focusRing"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_focus_ring"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/cameraProgress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:contentDescription="@string/starting_camera"
            android:indeterminateTint="@color/pix_accent" />

        <!-- The scene photo that was taken, over the camera, until it is used or shot again (R&S 6.3). -->
        <ImageView
            android:id="@+id/sceneStill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/pix_ground"
            android:contentDescription="@string/scene_photo_description"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- The guide's reference photo in a corner (FR-3.9). A tap enlarges it to half the preview's width, under the
             chips, and hides the hint; another tap makes it small again. A drag drops it into the nearest corner,
             above the guide's controls; its size and place are set in code. -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/referenceThumbnail"
            android:layout_width="54dp"
            android:layout_height="72dp"
            android:layout_gravity="top|left"
            android:background="@color/pix_ground"
            android:contentDescription="@string/reference_photo"
            android:padding="0.5dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Pix.SmallThumbnail"
            app:strokeColor="@color/pix_glass_stroke"
            app:strokeWidth="1dp"
            tools:ignore="RtlHardcoded"
            tools:visibility="visible" />

        <!-- Chips over the top of the preview: what just happened, then what to do. They pass touches through.
             The status chip fades in and out instead of making the hint jump. -->
        <LinearLayout
            android:id="@+id/topChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:animateLayoutChanges="true"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Saving, Photo saved, or why a photo failed (FR-1.6). -->
            <TextView
                android:id="@+id/captureStatus"
                style="@style/Widget.Pix.Chip.Small"
                android:layout_marginBottom="8dp"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone"
                tools:drawableStartCompat="@drawable/ic_check_circle_small"
                tools:text="@string/photo_saved"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/hintText"
                style="@style/Widget.Pix.Chip.Small"
                app:drawableStartCompat="@drawable/ic_target_small"
                app:drawableTint="@color/pix_accent"
                android:text="@string/hint_add_guide" />
        </LinearLayout>

        <!-- A subject is watching this camera (FR-6.8): a blinking red light at the image's top right, placed in code. -->
        <com.lastpenguin.pix.ui.camera.LiveDotView
            android:id="@+id/liveDot"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="top|left"
            android:accessibilityLiveRegion="polite"
            android:importantForAccessibility="yes"
            android:visibility="gone"
            tools:ignore="RtlHardcoded"
            tools:visibility="visible" />

        <!-- Over the bottom of the preview: remote action notices, then the guide's controls. -->
        <LinearLayout
            android:id="@+id/bottomOverlays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Remote action notice, such as "Junhyeong set zoom to 2×" (FR-7.4). -->
            <TextView
                android:id="@+id/noticeText"
                style="@style/Widget.Pix.Chip.Small"
                android:visibility="gone"
                tools:text="Junhyeong set zoom to 2×"
                tools:visibility="visible" />

            <!-- Brightness (FR-1.11), opened from the button beside the zoom readout; the value is in EV. -->
            <LinearLayout
                android:id="@+id/brightnessPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_glass_panel"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_brightness"
                    app:tint="@color/pix_text_soft" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/brightnessSlider"
                    style="@style/Widget.Pix.Slider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/brightness"
                    android:enabled="false"
                    android:value="1"
                    android:valueFrom="1"
                    android:valueTo="2" />

                <TextView
                    android:id="@+id/brightnessValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:importantForAccessibility="no"
                    android:minWidth="40dp"
                    android:textAppearance="@style/TextAppearance.Pix.Label.Bold"
                    tools:text="+0.7" />
            </LinearLayout>

            <!-- How to hold the phone for a generated pose (FR-4.10): open once when its guide comes, "Preparing a
                 tip…" until the tip arrives; a touch anywhere closes it, and the tip button in the top bar opens it
                 again. Translucent, so the preview shows through. -->
            <LinearLayout
                android:id="@+id/tipBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_glass_panel"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_lightbulb"
                    app:tint="@color/pix_accent" />

                <TextView
                    android:id="@+id/tipText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Pix.Body"
                    tools:text="Zoom in or take a step closer, hold the phone at your chest and keep it level - the body keeps its proportions." />
            </LinearLayout>

            <!-- Shown while a guide is on the camera (R&S 6.2, Camera + guide). -->
            <LinearLayout
                android:id="@+id/guideControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_glass_panel"
                android:gravity="center_vertical"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Hide / Show (FR-3.6): the guide goes away for a moment and comes back where it was. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/hideGuideButton"
                    style="@style/Widget.Pix.Button.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/hide_guide"
                    app:icon="@drawable/ic_visibility_off" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/opacitySlider"
                    style="@style/Widget.Pix.Slider.Guide"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/guide_opacity"
                    android:enabled="false"
                    android:value="0.5"
                    android:valueFrom="0.1"
                    android:valueTo="0.9" />

                <TextView
                    android:id="@+id/opacityValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:importantForAccessibility="no"
                    android:minWidth="34dp"
                    android:textAppearance="@style/TextAppearance.Pix.Label.Bold"
                    android:textColor="@color/slider_value_text"
                    tools:text="50%" />

                <!-- Save guide (FR-3.8): filled once the guide on the camera is saved. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveGuideButton"
                    style="@style/Widget.Pix.Button.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/save_guide"
                    app:icon="@drawable/ic_bookmark" />

                <Button
                    android:id="@+id/removeGuideButton"
                    style="@style/Widget.Pix.Button.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/remove_guide"
                    app:icon="@drawable/ic_close" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cameraMessagePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/pix_ground"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:background="@drawable/bg_icon_tile_large">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_camera_off" />
            </FrameLayout>

            <TextView
                android:id="@+id/cameraMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/camera_permission_message"
                android:textAppearance="@style/TextAppearance.Pix.BodyLarge" />

            <Button
                android:id="@+id/cameraActionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/open_settings" />

            <Button
                android:id="@+id/requestPermissionButton"
                style="@style/Widget.Pix.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/allow_camera"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:outlineProvider="none"
        android:translationZ="1dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- The brightness button, the applied zoom (FR-1.3), which a pinch on the preview changes, the pose tip's
             button, and the guide-edit mode toggle; the same row as Subject view, which has no tip. The readout keeps the Zoom in / Zoom out
             accessibility actions. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp">

            <!-- Opens the brightness slider over the preview (FR-1.11); checked while it is open. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/brightnessButton"
                style="@style/Widget.Pix.Button.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:checkable="true"
                android:contentDescription="@string/brightness"
                android:visibility="gone"
                app:backgroundTint="@color/brightness_button_background"
                app:icon="@drawable/ic_brightness"
                app:iconTint="@color/brightness_button_icon"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/zoomReadout"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_zoom_readout"
                android:focusable="true"
                android:gravity="center"
                android:importantForAccessibility="yes"
                android:minWidth="48dp"
                android:paddingHorizontal="10dp"
                android:textAppearance="@style/TextAppearance.Pix.Label.Bold"
                android:textColor="@color/zoom_readout_text"
                android:textSize="14sp"
                tools:text="1.0×" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:gravity="center_vertical">

                <!-- Opens the pose tip again while the guide on the camera has one (FR-4.10); the dot says a tip came
                     while the banner was closed. Beside the guide's own button, so the top bar fits any phone. -->
                <FrameLayout
                    android:id="@+id/tipButtonFrame"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tipButton"
                        style="@style/Widget.Pix.Button.Icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/show_tip"
                        app:icon="@drawable/ic_lightbulb" />

                    <ImageView
                        android:id="@+id/tipDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="7dp"
                        android:layout_marginEnd="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_status_dot"
                        android:visibility="gone"
                        app:tint="@color/pix_accent"
                        tools:visibility="visible" />
                </FrameLayout>

                <!-- Shown while a guide is on the camera (AD-17); checked while drags and pinches edit the guide. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editGuideButton"
                    style="@style/Widget.Pix.Button.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:contentDescription="@string/edit_guide"
                    android:visibility="gone"
                    app:backgroundTint="@color/edit_guide_background"
                    app:icon="@drawable/ic_move"
                    app:iconTint="@color/edit_guide_icon"
                    tools:visibility="visible" />
            </LinearLayout>
        </FrameLayout>

        <!-- Guide, shutter, and the last photo, in thirds and on one center line; the Guide label hangs below (R&S 6.2). -->
        <LinearLayout
            android:id="@+id/captureControls"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="4dp"
            android:baselineAligned="false"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/guideButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="20dp"
                    android:clickable="true"
                    android:contentDescription="@string/guide_add_description"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="8dp"
                    tools:ignore="UselessParent">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_guide_button"
                        android:duplicateParentState="true"
                        android:importantForAccessibility="no"
                        android:scaleType="center"
                        android:src="@drawable/ic_guide"
                        app:tint="@color/guide_button_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:layout_marginTop="4dp"
                        android:duplicateParentState="true"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:importantForAccessibility="no"
                        android:text="@string/guide"
                        android:textAppearance="@style/TextAppearance.Pix.Caption"
                        android:textColor="@color/pix_text_soft" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/shutterButton"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_shutter"
                    android:contentDescription="@string/shutter" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/galleryButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@color/pix_surface_2"
                    android:clickable="true"
                    android:contentDescription="@string/open_last_photo"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="1dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/gallery_placeholder"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Pix.Thumbnail"
                    app:strokeColor="#B3FFFFFF"
                    app:strokeWidth="2dp" />
            </FrameLayout>
        </LinearLayout>

        <!-- Replaces the row above while the scene photo is confirmed (R&S 6.3). -->
        <LinearLayout
            android:id="@+id/sceneReviewControls"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:visibility="gone"
            tools:ignore="ButtonStyle">

            <Button
                android:id="@+id/shootAgainButton"
                style="@style/Widget.Pix.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/shoot_again" />

            <Button
                android:id="@+id/usePhotoButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/use_this_photo" />
        </LinearLayout>
    </LinearLayout>
</com.lastpenguin.pix.ui.camera.TouchWatchingLayout>
