<?xml version="1.0" encoding="utf-8"?>
<!-- One field and its rule in a dialog: the name and Add a password on the Account sheet. The hint, set by the sheet
     for each dialog, is the field's accessibility label. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp">

    <EditText
        android:id="@+id/input"
        style="@style/Widget.Pix.TextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAutofill="no"
        android:inputType="text"
        tools:ignore="LabelFor" />

    <TextView
        android:id="@+id/ruleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:accessibilityLiveRegion="polite"
        android:textAppearance="@style/TextAppearance.Pix.Body.Small"
        android:textColor="@color/pix_text_faint" />
</LinearLayout>
