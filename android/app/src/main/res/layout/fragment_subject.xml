<?xml version="1.0" encoding="utf-8"?>
<!-- Subject view (R&S 6.6, FR-6.6, FR-6.7, FR-7.1–7.3). No shutter: only the photographer takes photos. A pinch on
     the video zooms the photographer's camera while guide-edit mode is off (AD-17); with it on, drags and pinches
     move the photographer's guide. The brightness slider and the flash button are the photographer's controls. The
     video is placed as on the Camera screen (previewArea, in code), and the zoom row and the caption lie above it. The
     root reports the end of every touch, which closes the photographer's tip (FR-4.10). -->
<com.lastpenguin.pix.ui.camera.TouchWatchingLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/camera_bar">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:outlineProvider="none"
        android:paddingHorizontal="10dp"
        android:paddingVertical="0dp"
        android:translationZ="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- The photographer's flash, cycled from here (FR-7.3); hidden when their phone has none. -->
        <com.lastpenguin.pix.ui.camera.TurningButton
            android:id="@+id/flashButton"
            style="@style/Widget.Pix.Button.Icon.TopBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/flash_off"
            android:visibility="gone"
            app:icon="@drawable/ic_flash_off"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <!-- The latency indicator, when Settings turns it on (FR-10.3). -->
        <TextView
            android:id="@+id/latencyChip"
            style="@style/Widget.Pix.Chip.Small"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="@dimen/top_bar_overhang"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_status_dot"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/settingsButton"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="@string/latency_value"
            tools:visibility="visible" />

        <!-- Settings (FR-10.1), beside Leave as on the photographer's Camera screen (#204). -->
        <com.lastpenguin.pix.ui.camera.TurningButton
            android:id="@+id/settingsButton"
            style="@style/Widget.Pix.Button.Icon.TopBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/settings"
            app:icon="@drawable/ic_settings"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/leaveButton"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Red, as End session on the photographer's Camera screen (#271). -->
        <Button
            android:id="@+id/leaveButton"
            style="@style/Widget.Pix.Button.Glass.Danger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/leave"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="44dp"
        android:background="@color/pix_ground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- The photographer's live video, the whole frame in the ratio they chose (Design 2.6.4, AD-10). It wraps
             its content so that it measures itself to the video's shape and is centered, the same rectangle the
             grid and the guide fit; at match_parent the renderer would crop every frame to the view's shape. -->
        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/liveView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="@string/subject_video_description" />

        <!-- Darkens the video before its first frame, while a text covers it, while the photographer's new ratio comes,
             and for a moment at their shutter (Design 2.6.4). A view over the renderer, whose surface takes no fade. -->
        <View
            android:id="@+id/videoScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/pix_ground"
            android:importantForAccessibility="no" />

        <!-- The same 3×3 grid as the photographer's preview, over the same fitted image; no level bar here. -->
        <com.lastpenguin.pix.ui.camera.CameraCompositionView
            android:id="@+id/compositionOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <!-- "Connecting…" until the peer connection is up, or "camera paused" when frames stop. -->
        <TextView
            android:id="@+id/connectingText"
            style="@style/Widget.Pix.Chip.Small"
            android:layout_gravity="center"
            android:accessibilityLiveRegion="polite"
            android:text="@string/connecting" />

        <!-- The synced guide (#9). Editable only while guide-edit mode is on; moving it is #57. -->
        <com.lastpenguin.pix.guide.GuideOverlayView
            android:id="@+id/guideOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Where a tap asked the photographer's camera to focus (FR-7.7), as on their Camera screen: placed at the
             tap and faded out (FocusBrightness). -->
        <View
            android:id="@+id/focusRing"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_focus_ring"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <!-- The photographer's brightness (FR-7.3): the Camera screen's bar beside the focus box, in place of the
             button and the slider this screen had (#273). A drag on it, or up and down on the video, sends the
             brightness, and it fades out after a few seconds without a touch. 48 dp wide for the touch (NFR-16);
             placed in code. -->
        <com.lastpenguin.pix.ui.camera.ExposureBarView
            android:id="@+id/exposureBar"
            android:layout_width="48dp"
            android:layout_height="128dp"
            android:layout_gravity="top|left"
            android:visibility="gone"
            tools:ignore="RtlHardcoded"
            tools:visibility="visible" />

        <!-- The photographer's reference photo (FR-3.9), as on their Camera screen: a tap enlarges it, a drag moves it
             to another corner of this phone's video. Sized and placed in code; over the guide, so it takes its touches. -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/referenceThumbnail"
            android:layout_width="54dp"
            android:layout_height="72dp"
            android:layout_gravity="top|left"
            android:background="@color/pix_ground"
            android:contentDescription="@string/reference_photo"
            android:padding="0.5dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Pix.SmallThumbnail"
            app:strokeColor="@color/pix_glass_stroke"
            app:strokeWidth="1dp"
            tools:ignore="RtlHardcoded"
            tools:visibility="visible" />

        <!-- A hidden thumbnail's strip is too narrow for a finger (FR-3.9, #237): this lies over it, a touch target
             wide, and its touches are the thumbnail's. Sized and placed in code; nothing to TalkBack, which uses the
             thumbnail's own actions. -->
        <View
            android:id="@+id/referenceHandle"
            android:layout_width="48dp"
            android:layout_height="72dp"
            android:layout_gravity="top|left"
            android:importantForAccessibility="no"
            android:visibility="gone"
            tools:ignore="RtlHardcoded" />

        <!-- The photographer's camera is streaming (FR-6.6, FR-6.8): the light at the video's top right, placed in code;
             its description names the photographer. -->
        <com.lastpenguin.pix.ui.camera.LiveDotView
            android:id="@+id/liveDot"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="top|left"
            android:accessibilityLiveRegion="polite"
            android:importantForAccessibility="yes"
            android:visibility="gone"
            tools:ignore="RtlHardcoded"
            tools:visibility="visible" />

        <!-- What a toggle just did, such as "2×" or "Saved to My library", for a few seconds at the top of the video, as
             on the Camera screen (Design 2.8); a new one replaces it at once, and TalkBack reads it. -->
        <TextView
            android:id="@+id/toggleLabel"
            style="@style/Widget.Pix.Chip.Small"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="@string/guide_saved_notice"
            tools:visibility="visible" />
    </FrameLayout>

    <!-- Right above the caption, as the Camera screen's panels sit above its shutter: the photographer's tip
         (FR-4.10), opened from its button in the zoom row. -->
    <LinearLayout
        android:id="@+id/bottomOverlays"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:outlineProvider="none"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp"
        android:translationZ="1dp"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- The photographer's tip of the guide on the video (FR-4.10, #213), as on their Camera screen: the tip's
             sentences, one on a line. Closed until the tip button; a touch anywhere closes it again. Translucent, so
             the video shows through. -->
        <LinearLayout
            android:id="@+id/tipBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_glass_panel"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/tipIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_lightbulb"
                app:tint="@color/pix_accent" />

            <TextView
                android:id="@+id/tipText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Pix.Body"
                tools:text="Move a little closer.\nHold the phone at your waist, tilted up a little." />
        </LinearLayout>

    </LinearLayout>

    <!-- The Camera screen's row: the photographer's tip (FR-4.10) at its start, the zoom readout (FR-7.1), then Save
         guide (FR-6.16) and the guide-edit mode toggle, over the bottom of the video (placed in code). The tip is at
         the start, where there is room: three buttons at the end reach the readout on a narrow phone. -->
    <FrameLayout
        android:id="@+id/zoomRow"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:outlineProvider="none"
        android:paddingHorizontal="12dp"
        android:translationZ="1dp"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:gravity="center_vertical">

            <!-- Opens the photographer's tip while the guide on the video has one (FR-4.10, #213); the dot says there
                 is a tip not yet looked at, since the tip never opens by itself here. -->
            <FrameLayout
                android:id="@+id/tipButtonFrame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="visible">

                <com.lastpenguin.pix.ui.camera.TurningButton
                    android:id="@+id/tipButton"
                    style="@style/Widget.Pix.Button.Icon.OnPhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/show_tip"
                    app:icon="@drawable/ic_lightbulb" />

                <ImageView
                    android:id="@+id/tipDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="7dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_status_dot"
                    android:visibility="gone"
                    app:tint="@color/pix_accent"
                    tools:visibility="visible" />
            </FrameLayout>
        </LinearLayout>

        <com.lastpenguin.pix.ui.camera.TurningLabel
            android:id="@+id/zoomReadout"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@drawable/bg_zoom_readout"
            android:focusable="true"
            android:gravity="center"
            android:importantForAccessibility="yes"
            android:minWidth="48dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textAppearance="@style/TextAppearance.Pix.Label.Bold"
            android:textColor="@color/zoom_readout_text"
            android:textSize="11sp"
            tools:text="1.0×" />

        <!-- Save guide (FR-6.16), beside the toggle while a guide is on the video: filled once saved on this phone. -->
        <com.lastpenguin.pix.ui.camera.TurningButton
            android:id="@+id/saveGuideButton"
            style="@style/Widget.Pix.Button.Icon.OnPhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="48dp"
            android:contentDescription="@string/save_guide"
            android:visibility="gone"
            app:icon="@drawable/ic_bookmark"
            tools:visibility="visible" />

        <!-- Shown while a guide is on the video (AD-17); checked while gestures edit the guide. One person's outline, lit
             in the guide's color while checked, as on Camera (#271). -->
        <com.lastpenguin.pix.ui.camera.TurningButton
            android:id="@+id/editGuideButton"
            style="@style/Widget.Pix.Button.Icon.OnPhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:layout_gravity="end|center_vertical"
            android:contentDescription="@string/edit_guide"
            android:visibility="gone"
            app:backgroundTint="@color/edit_guide_background"
            app:strokeColor="@color/edit_guide_stroke"
            app:icon="@drawable/ic_guide_mode"
            app:iconTint="@color/edit_guide_icon"
            tools:visibility="visible" />
    </FrameLayout>

    <!-- Over the guide-edit mode toggle, for a few seconds after a tap: what a pinch moves now, Guide or Camera
         (Design 2.8). Moved with the zoom row in code. -->
    <TextView
        android:id="@+id/pinchModeLabel"
        style="@style/Widget.Pix.Chip.Small"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        android:accessibilityLiveRegion="polite"
        android:outlineProvider="none"
        android:translationZ="1dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/zoomRow"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="@string/pinch_mode_guide"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:outlineProvider="none"
        android:translationZ="1dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Camera's row in thirds (R&S 6.6): Guide in the middle of the left third, where Camera's is, and in the
             middle, where Camera's shutter is, whose camera this is, or a step's button such as Pick a pose (FR-6.15); the
             session photos' thumbnail, a view of the screen's own, in the middle of the right third. Each is centered
             on its line, so a longer label grows both ways. Held sideways, Pick a pose turns with its label and stands
             taller than the row, so neither clips it (FR-1.15). -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/guideRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.1667" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/middleLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.5" />

            <!-- The Camera screen's Guide button: the guide chosen here goes to the photographer (FR-6.15). -->
            <LinearLayout
                android:id="@+id/guideButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:contentDescription="@string/guide_add_description"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="@id/guideLine"
                app:layout_constraintStart_toStartOf="@id/guideLine"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/guideButtonIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_guide_button"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_guide"
                    app:tint="@color/guide_button_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:duplicateParentState="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:importantForAccessibility="no"
                    android:text="@string/guide"
                    android:textAppearance="@style/TextAppearance.Pix.Caption"
                    android:textColor="@color/pix_text_soft" />
            </LinearLayout>

            <!-- Opens the subject's Pick a pose or Your reference again while the photographer's step lasts (FR-6.15). -->
            <LinearLayout
                android:id="@+id/pickPoseButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:contentDescription="@string/pick_pose_title"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@id/middleLine"
                app:layout_constraintStart_toStartOf="@id/middleLine"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_guide_button"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_sparkle"
                    app:tint="@color/guide_button_icon" />

                <!-- At most 128 dp wide, so at a large font a long step's name takes two lines, clear of Guide and the
                     thumbnail, rather than reaching them (#298). -->
                <TextView
                    android:id="@+id/pickPoseLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="128dp"
                    android:layout_marginTop="4dp"
                    android:duplicateParentState="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:importantForAccessibility="no"
                    android:text="@string/pick_pose_title"
                    android:textAppearance="@style/TextAppearance.Pix.Caption"
                    android:textColor="@color/pix_text_soft" />
            </LinearLayout>

            <!-- The slot's text, between Guide and the thumbnail, centered on their icons' line, as tall as Guide's icon;
                 from 28 % to 72 % of the row, clear of Guide's label at a font scale of 200 % (#298). -->
            <Space
                android:id="@+id/iconLine"
                android:layout_width="0dp"
                android:layout_height="40dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/captionStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.28" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/captionEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.72" />

            <!-- Once connected, in the slot where Camera's shutter is (#271): whose camera this is, and that it is live,
                 or that their photo is on its way here (FR-6.14), centered on the line of Guide's icon and the
                 thumbnail, not on Guide's label. A step's button takes the slot while it shows. -->
            <LinearLayout
                android:id="@+id/cameraCaption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/iconLine"
                app:layout_constraintEnd_toEndOf="@id/captionEnd"
                app:layout_constraintStart_toStartOf="@id/captionStart"
                app:layout_constraintTop_toTopOf="@id/iconLine"
                tools:visibility="visible">

                <!-- A long name, or a large font, makes the text smaller, down to 12 dp, not sp, so a line fits at any
                     font scale, 200 % included (#298); a name still too long is cut short so "'s camera" stays
                     (SubjectFragment.cameraTitle). 24 dp holds a line of 15 sp, the size it starts at. -->
                <TextView
                    android:id="@+id/cameraCaptionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:autoSizeMaxTextSize="15sp"
                    android:autoSizeMinTextSize="12dp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Pix.Label.Bold"
                    android:textColor="@color/pix_text"
                    tools:text="Dongje's camera" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical">

                    <!-- Red, as the light over the video, while live; a spinner while a photo comes. -->
                    <ImageView
                        android:id="@+id/cameraCaptionDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_status_dot"
                        app:tint="@color/pix_recording" />

                    <ProgressBar
                        android:id="@+id/cameraCaptionSpinner"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:importantForAccessibility="no"
                        android:indeterminateTint="@color/pix_text_soft"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/cameraCaptionStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:accessibilityLiveRegion="polite"
                        android:maxLines="1"
                        android:text="@string/subject_live"
                        android:textAppearance="@style/TextAppearance.Pix.Label"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <!-- The middle of the row's right third (the panel's 16 dp padding and five sixths of the rest), as far from the
         right edge as Guide is from the left. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/thumbnailLine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.8037" />

    <!-- The session's newest photo (FR-6.14), Camera's thumbnail: a 40 dp image in a 48 dp touch area (NFR-16), on
         Guide's icon line (the panel's 8 dp padding and half the 40 dp icon), centered on the line above. Empty, and
         taking no tap, until a photo is saved here; a tap then opens the session's photos in the viewer below. -->
    <FrameLayout
        android:id="@+id/galleryButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:clickable="true"
        android:contentDescription="@string/open_newest_photo"
        android:focusable="true"
        android:outlineProvider="none"
        android:translationZ="1dp"
        app:layout_constraintEnd_toEndOf="@id/thumbnailLine"
        app:layout_constraintStart_toStartOf="@id/thumbnailLine"
        app:layout_constraintTop_toTopOf="@id/bottomPanel">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/galleryThumbnail"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="@color/pix_glass"
            android:duplicateParentState="true"
            android:foreground="?attr/selectableItemBackground"
            android:importantForAccessibility="no"
            android:padding="1dp"
            android:scaleType="centerCrop"
            android:src="@drawable/gallery_placeholder"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Pix.Thumbnail"
            app:strokeColor="@color/camera_thumbnail_stroke"
            app:strokeWidth="1.5dp" />
    </FrameLayout>

    <!-- The session's photos (FR-6.14, R&S 6.6), over the whole screen. Built in this empty holder when it first opens,
         so a screen that never opens it builds no pager. -->
    <FrameLayout
        android:id="@+id/photoViewerHolder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:outlineProvider="none"
        android:translationZ="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</com.lastpenguin.pix.ui.camera.TouchWatchingLayout>
