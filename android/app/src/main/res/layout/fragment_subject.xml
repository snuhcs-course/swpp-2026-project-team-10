<?xml version="1.0" encoding="utf-8"?>
<!-- Subject view (R&S 6.6, FR-6.6, FR-6.7, FR-7.1). No shutter: only the photographer takes photos. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- "<name>'s camera" with the name from hello (FR-6.6). -->
        <TextView
            android:id="@+id/photographerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/subject_title_placeholder" />

        <Button
            android:id="@+id/leaveButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/leave" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <!-- The photographer's live video, aspect-fit so the whole 3:4 frame is visible (Design 2.6.4, AD-10).
             Pinching it zooms the photographer's camera (FR-7.1). -->
        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/liveView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Shown until the peer connection is up. -->
        <TextView
            android:id="@+id/connectingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/connecting"
            android:textColor="#FFFFFF" />

        <!-- The synced guide (#9). The subject cannot move or resize it in Iteration 1. -->
        <com.lastpenguin.pix.guide.GuideOverlayView
            android:id="@+id/guideOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- The photographer's zoom, with the same readout as the Camera screen; enabled while connected (FR-7.1). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/zoomRatio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:gravity="center"
            android:importantForAccessibility="yes"
            android:minWidth="64dp"
            android:minHeight="48dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            tools:text="1.0×" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/pinch_to_zoom"
            android:textAppearance="?attr/textAppearanceBodyMedium" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/subject_caption" />
</LinearLayout>
