<?xml version="1.0" encoding="utf-8"?>
<!-- A page of the photo viewer (view_photo_viewer): the photo, whole until a pinch or a double tap zooms it, or why it
     is not there. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.lastpenguin.pix.ui.camera.ZoomablePhotoView
        android:id="@+id/photoPageImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- A photo deleted from the album since, or one that cannot be read. -->
    <TextView
        android:id="@+id/photoPageMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="20dp"
        android:gravity="center"
        android:text="@string/session_photo_unavailable"
        android:textAppearance="@style/TextAppearance.Pix.Body"
        android:visibility="gone"
        tools:visibility="visible" />
</FrameLayout>
