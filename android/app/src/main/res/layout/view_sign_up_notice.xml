<?xml version="1.0" encoding="utf-8"?>
<!-- What a Pix account keeps, on Sign up and Sign up with Google before the account is made, and the agreement that
     the account waits for (FR-5.18): what, why, how long, and who receives it, with the privacy policy. SignUpNotice
     fills it and reads the agreement. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Pix.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/sign_up_notice_title"
                android:textAppearance="@style/TextAppearance.Pix.Action"
                android:textColor="@color/pix_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/sign_up_notice_what_label"
                android:textAppearance="@style/TextAppearance.Pix.Label.Bold"
                android:textColor="@color/pix_text_muted" />

            <TextView
                android:id="@+id/whatText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/sign_up_notice_what_password"
                android:textAppearance="@style/TextAppearance.Pix.Body"
                android:textColor="@color/pix_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/sign_up_notice_why_label"
                android:textAppearance="@style/TextAppearance.Pix.Label.Bold"
                android:textColor="@color/pix_text_muted" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/sign_up_notice_why"
                android:textAppearance="@style/TextAppearance.Pix.Body"
                android:textColor="@color/pix_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/sign_up_notice_how_long_label"
                android:textAppearance="@style/TextAppearance.Pix.Label.Bold"
                android:textColor="@color/pix_text_muted" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/sign_up_notice_how_long"
                android:textAppearance="@style/TextAppearance.Pix.Body"
                android:textColor="@color/pix_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/sign_up_notice_who_label"
                android:textAppearance="@style/TextAppearance.Pix.Label.Bold"
                android:textColor="@color/pix_text_muted" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/sign_up_notice_who"
                android:textAppearance="@style/TextAppearance.Pix.Body"
                android:textColor="@color/pix_text" />

            <Button
                android:id="@+id/policyButton"
                style="@style/Widget.Pix.Button.Text.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-12dp"
                android:layout_marginTop="4dp"
                android:text="@string/sign_up_notice_policy" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/agreeCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="48dp"
        android:text="@string/sign_up_agree"
        android:textAppearance="@style/TextAppearance.Pix.Body"
        android:textColor="@color/pix_text" />
</LinearLayout>
