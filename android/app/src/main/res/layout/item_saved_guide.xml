<?xml version="1.0" encoding="utf-8"?>
<!-- One saved guide on Add a pose guide's My library (FR-3.11): its thumbnail and the icon of its kind. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="84dp"
    android:layout_height="112dp"
    android:layout_marginEnd="10dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/thumbnail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/pix_surface_2"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:padding="0.5dp"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Pix.SmallThumbnail"
        app:strokeColor="@color/pix_glass_stroke"
        app:strokeWidth="1dp" />

    <ImageView
        android:id="@+id/kindIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="6dp"
        android:background="@drawable/bg_kind_badge"
        android:importantForAccessibility="no"
        android:padding="5dp"
        app:tint="@color/pix_text" />
</FrameLayout>
