<?xml version="1.0" encoding="utf-8"?>
<!-- Generate poses (R&S 6.3, FR-4.8), and the subject's (R&S 6.6): what to pose, asked before anything is sent. Back
     at the top left, the one button at the top right (#199). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp">

            <!-- Back to the scene photo's review (#199). -->
            <ImageButton
                android:id="@+id/backButton"
                style="@style/Widget.Pix.Header.Back"
                android:contentDescription="@string/back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/describe_title"
                android:textAppearance="@style/TextAppearance.Pix.Header" />

            <!-- The one button (Iter3-A13, #199): suggested poses for an empty field, which says Auto, else poses of
                 the description (FR-4.4, FR-4.8, FR-4.15, US-5). Named in full, so it is a MaterialButton under any
                 activity, which the tutorial's ring around its text needs (#204). -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/generateButton"
                style="@style/Widget.Pix.Button.Header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/generate_from_description" />
        </LinearLayout>

        <!-- Where this screen is in the pose flow (R&S 6.3, #210): Generate poses, 2 of 4. Across the screen, past this
             layout's padding. -->
        <com.lastpenguin.pix.ui.FlowProgressView
            android:id="@+id/flowProgress"
            android:layout_width="match_parent"
            android:layout_height="@dimen/flow_progress_height"
            android:layout_marginStart="-20dp"
            android:layout_marginEnd="-20dp"
            app:flowStep="2" />

        <!-- The scene photo the poses are made from. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_info_card"
            android:gravity="center_vertical"
            android:padding="12dp">

            <!-- A tap shows the photo large (FR-4.15, ScenePhotoFragment), which the badge on its corner says. At least
                 48 dp wide for the tap, also around a 9:16 photo. -->
            <FrameLayout
                android:id="@+id/scenePhotoButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/scene_photo_description"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:minWidth="48dp">

                <!-- 72 dp high and as wide as the photo's shape (showScene): 54 dp for 3:4, 9:16 narrower, 1:1 square. -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/sceneImage"
                    android:layout_width="54dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:background="@color/pix_surface_2"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Pix.SmallThumbnail" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_photo_badge"
                    android:importantForAccessibility="no"
                    android:padding="4dp"
                    android:src="@drawable/ic_enlarge_small"
                    app:tint="@color/pix_text" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/your_photo"
                    android:textAppearance="@style/TextAppearance.Pix.Action.Small"
                    android:textColor="@color/pix_text" />

                <!-- The situation the photo was taken for (FR-4.8), which a new photo changes; none for Auto, which the
                     field says already (FR-4.15), nor from an older photographer. -->
                <TextView
                    android:id="@+id/situationTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_situation_tag"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textAppearance="@style/TextAppearance.Pix.Label"
                    android:textColor="@color/pix_accent"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="Landmark"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/descriptionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/describe_label"
            android:textAppearance="@style/TextAppearance.Pix.Action.Small"
            android:textColor="@color/pix_text" />

        <!-- Korean or English; input stops at 100 characters (FR-4.8). It wraps, and Done closes the keyboard. Empty and
             left alone it says Auto, with what Auto does (FR-4.15): DescriptionForm sets that as its hint, in lines as
             high as the text's, and the example once it is tapped; it also keeps the field three lines high, which
             Auto's hint takes, so nothing under it moves when a text replaces the hint. The hint is its accessibility
             label, so the label above does not point at it (lint LabelFor). Nothing stands in it but its text. -->
        <EditText
            android:id="@+id/descriptionInput"
            style="@style/Widget.Pix.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="top|start"
            android:hint="@string/describe_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:lineHeight="@dimen/description_line_height"
            android:maxLength="100" />

        <!-- Shown after the service refused every pose of the description, for the photo or the text; the text is kept
             (US-5). On a line of its own, over the one that leads to typing or back to Auto. -->
        <TextView
            android:id="@+id/descriptionError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/description_refused"
            android:textAppearance="@style/TextAppearance.Pix.Body.Small"
            android:textColor="@color/pix_danger_text"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- One line under the field, which says how to get to the other way (FR-4.15): to typing while the field says
             Auto, back to Auto while it holds text; then the counter at its end, under the field's right edge. One
             touch target high in every state, so nothing under it moves when one takes the other's place. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <!-- Under a field that says Auto: it can be typed in. A little stronger than a caption, with a pencil
                     in the accent, since it is all there is under the field then. -->
                <TextView
                    android:id="@+id/descriptionHelper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:drawablePadding="6dp"
                    android:drawableStart="@drawable/ic_edit_small"
                    android:drawableTint="@color/pix_accent"
                    android:text="@string/describe_auto_helper"
                    android:textAppearance="@style/TextAppearance.Pix.Label"
                    android:textColor="@color/pix_text_soft" />

                <!-- Back to Auto, in the same place while the field holds text and is not waiting (Iter3-A13's ✕ before):
                     it empties the field, so the one button asks for suggested poses again. A sentence with an arrow
                     turning back, not a mark inside the field, which read as part of the text. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clearDescriptionButton"
                    style="@style/Widget.Pix.Button.Text.Line"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:text="@string/back_to_auto"
                    android:visibility="gone"
                    app:icon="@drawable/ic_undo_small"
                    tools:visibility="visible" />
            </FrameLayout>

            <TextView
                android:id="@+id/descriptionCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textAppearance="@style/TextAppearance.Pix.Caption"
                tools:text="0/100" />
        </LinearLayout>

        <!-- In a session: "Joonhyung is typing…" while the other phone's field holds the description (FR-6.15). -->
        <TextView
            android:id="@+id/descriptionTyping"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.Pix.Body.Small"
            android:textColor="@color/pix_accent"
            android:visibility="gone"
            tools:text="Joonhyung is typing…"
            tools:visibility="visible" />

        <!-- The options (FR-4.15), once the field was tapped or holds text: the situation's poses as chips, one
             item_option_chip each. A tap writes the chip's words into the field, and another takes them out. -->
        <LinearLayout
            android:id="@+id/optionsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/options_label"
                android:textAppearance="@style/TextAppearance.Pix.Overline" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/optionChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="0dp" />
        </LinearLayout>

        <!-- The descriptions used before (FR-4.11), hidden while there are none, and under a field that says Auto until
             it is tapped (FR-4.15): the header with, in a session with a friend, the All / With <name> switch, then the
             entries as chips, newest first, each with a ✕. -->
        <LinearLayout
            android:id="@+id/historySection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/history_label"
                    android:textAppearance="@style/TextAppearance.Pix.Overline" />

                <!-- The whole history, or the one with the session's friend; gone without a friend (a room code, or
                     no session). The chosen half is selected. -->
                <LinearLayout
                    android:id="@+id/historyFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_segment_track"
                    android:padding="2dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <Button
                        android:id="@+id/historyAll"
                        style="@style/Widget.Pix.Button.Segment.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/history_all" />

                    <!-- A name may have 30 characters: cut short, so All stays on the screen beside it. -->
                    <Button
                        android:id="@+id/historyWithPartner"
                        style="@style/Widget.Pix.Button.Segment.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:maxWidth="160dp"
                        tools:text="With Joonhyung" />
                </LinearLayout>
            </LinearLayout>

            <!-- One item_history_chip per entry shown; a tap fills the field, which can then be edited. -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/historyChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="0dp" />

            <!-- With the friend chosen and nothing used with them yet. -->
            <TextView
                android:id="@+id/historyEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.Pix.Body.Small"
                android:visibility="gone"
                tools:text="Nothing used with Joonhyung yet"
                tools:visibility="visible" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <!-- In a session: the other phone shows this step too, and either one can write and go on (FR-6.15). -->
        <TextView
            android:id="@+id/sharedHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Pix.Body.Small"
            android:visibility="gone"
            tools:text="Joonhyung sees this too"
            tools:visibility="visible" />
    </LinearLayout>
</ScrollView>
