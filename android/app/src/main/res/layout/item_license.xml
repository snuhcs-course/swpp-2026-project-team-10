<?xml version="1.0" encoding="utf-8"?>
<!-- One library or font on About Pix, with its license. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/libraryName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Pix.Label"
        tools:text="WebRTC" />

    <TextView
        android:id="@+id/libraryLicense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.Pix.Body.Small"
        tools:text="BSD 3-Clause License" />
</LinearLayout>
