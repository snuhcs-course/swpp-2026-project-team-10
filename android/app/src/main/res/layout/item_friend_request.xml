<?xml version="1.0" encoding="utf-8"?>
<!-- A received friend request on Friends, with Accept and Decline (FR-5.7, US-8). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_list_card"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:paddingVertical="12dp"
    android:paddingStart="14dp"
    android:paddingEnd="8dp">

    <TextView
        android:id="@+id/avatarText"
        style="@style/Widget.Pix.Avatar"
        tools:text="T" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Pix.Action.Small"
            android:textColor="@color/pix_text"
            tools:text="Test Account 3" />

        <TextView
            android:id="@+id/pixIdText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Pix.Body.Small"
            tools:text="\@test3" />
    </LinearLayout>

    <Button
        android:id="@+id/declineButton"
        style="@style/Widget.Pix.Button.Text.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/decline" />

    <Button
        android:id="@+id/acceptButton"
        style="@style/Widget.Pix.Button.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/accept" />
</LinearLayout>
