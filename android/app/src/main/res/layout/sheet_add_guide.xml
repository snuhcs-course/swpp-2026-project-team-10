<?xml version="1.0" encoding="utf-8"?>
<!-- Add a pose guide (R&S 6.2). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingBottom="24dp">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" />

    <!-- With a guide on the camera, the sheet asks to replace it (FR-3.6); its Cancel keeps the current guide. -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:accessibilityHeading="true"
        android:text="@string/add_guide_title"
        android:textAppearance="@style/TextAppearance.Pix.SheetTitle" />

    <!-- My library (FR-3.8, FR-3.11): Add photo, then the newest saved guides; All opens the library. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:minHeight="48dp">

        <TextView
            android:id="@+id/libraryTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/my_library"
            android:textAppearance="@style/TextAppearance.Pix.Header" />

        <Button
            android:id="@+id/libraryAllButton"
            style="@style/Widget.Pix.Button.Text.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/savedGuidesScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/addPhotoTile"
                android:layout_width="84dp"
                android:layout_height="112dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_add_photo_tile"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_plus"
                    app:tint="@color/pix_text_soft" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/add_photo"
                    android:textAppearance="@style/TextAppearance.Pix.Label"
                    android:textColor="@color/pix_text_muted" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/savedGuidesList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/generateButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_option_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="88dp"
        android:paddingVertical="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_icon_tile_accent">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_sparkle"
                app:tint="@color/pix_on_accent" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/generate_poses"
            android:textAppearance="@style/TextAppearance.Pix.Action"
            android:textColor="@color/pix_text" />

        <ImageView
            android:id="@+id/generateChevron"
            style="@style/Widget.Pix.Chevron"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <Button
        android:id="@+id/cancelButton"
        style="@style/Widget.Pix.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/cancel" />
</LinearLayout>
