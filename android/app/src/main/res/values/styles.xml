<?xml version="1.0" encoding="utf-8"?>
<!-- Type, shapes, and component styles over the tokens in colors.xml. Every control is at least 44 dp tall, and the
     camera screens' 48 x 48 dp (NFR-16), though they draw smaller shapes inside that. Radii (#199): fully round for
     chips and pills, 12 for small thumbnails, 16 for buttons, fields, info cards, and pose slots, 24 for large cards
     and images, 28 for sheets. Spacing is 8, 12, 16, or 24 dp, with 20 dp at the screen's sides and bottom. -->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Type: Manrope for the UI (Pretendard on a phone in Korean: the @font/pix_* aliases), DM Mono for the room code. -->
    <!-- Every text appearance breaks Korean between words (phrase, Android 13+); before 13, Android breaks inside them. -->
    <style name="TextAppearance.Pix.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:lineBreakWordStyle" tools:targetApi="33">phrase</item>
        <item name="android:fontFamily">@font/pix_extrabold</item>
        <item name="fontFamily">@font/pix_extrabold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/pix_text</item>
    </style>

    <style name="TextAppearance.Pix.SheetTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:lineBreakWordStyle" tools:targetApi="33">phrase</item>
        <item name="android:fontFamily">@font/pix_extrabold</item>
        <item name="fontFamily">@font/pix_extrabold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/pix_text</item>
    </style>

    <!-- The shutter's countdown over the image (FR-1.17): large enough to read from where the people in the photo stand,
         with a shadow so it shows on a bright scene. Its size is the view's, in dp (#298): a larger font would not fit
         the number's square. -->
    <style name="TextAppearance.Pix.Countdown" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:lineBreakWordStyle" tools:targetApi="33">phrase</item>
        <item name="android:fontFamily">@font/pix_extrabold</item>
        <item name="fontFamily">@font/pix_extrabold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/pix_text</item>
        <item name="android:shadowColor">@color/camera_dim</item>
        <item name="android:shadowDy">4</item>
        <item name="android:shadowRadius">24</item>
    </style>

    <style name="TextAppearance.Pix.Header" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:lineBreakWordStyle" tools:targetApi="33">phrase</item>
        <item name="android:fontFamily">@font/pix_bold</item>
        <item name="fontFamily">@font/pix_bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/pix_text</item>
    </style>

    <style name="TextAppearance.Pix.Action" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:lineBreakWordStyle" tools:targetApi="33">phrase</item>
        <item name="android:fontFamily">@font/pix_bold</item>
        <item name="fontFamily">@font/pix_bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- A caption of the first-use tutorial over the dimmed screen (FR-10.4). -->
    <style name="TextAppearance.Pix.Tutorial" parent="TextAppearance.Pix.Action">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/pix_text</item>
        <item name="android:lineSpacingMultiplier">1.08</item>
    </style>

    <!-- "Auto" in Generate poses' empty field (FR-4.15): a value in the accent, as a camera shows a setting left on
         auto. -->
    <style name="TextAppearance.Pix.Action.Accent">
        <item name="android:textColor">@color/pix_accent</item>
    </style>

    <style name="TextAppearance.Pix.Action.Small">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.Pix.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:lineBreakWordStyle" tools:targetApi="33">phrase</item>
        <item name="android:fontFamily">@font/pix_medium</item>
        <item name="fontFamily">@font/pix_medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/pix_text_soft</item>
    </style>

    <style name="TextAppearance.Pix.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:lineBreakWordStyle" tools:targetApi="33">phrase</item>
        <item name="android:fontFamily">@font/pix_medium</item>
        <item name="fontFamily">@font/pix_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/pix_text_muted</item>
    </style>

    <!-- What the scene photo for poses should hold, on its panel above the shutter (R&S 6.3, #210). -->
    <style name="TextAppearance.Pix.Instruction" parent="TextAppearance.Pix.Body">
        <item name="android:fontFamily">@font/pix_semibold</item>
        <item name="fontFamily">@font/pix_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/pix_text</item>
    </style>

    <style name="TextAppearance.Pix.Body.Small">
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TextAppearance.Pix.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:lineBreakWordStyle" tools:targetApi="33">phrase</item>
        <item name="android:fontFamily">@font/pix_semibold</item>
        <item name="fontFamily">@font/pix_semibold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/pix_text_soft</item>
    </style>

    <style name="TextAppearance.Pix.Label.Bold">
        <item name="android:fontFamily">@font/pix_bold</item>
        <item name="fontFamily">@font/pix_bold</item>
    </style>

    <style name="TextAppearance.Pix.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:lineBreakWordStyle" tools:targetApi="33">phrase</item>
        <item name="android:fontFamily">@font/pix_bold</item>
        <item name="fontFamily">@font/pix_bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/pix_text_muted</item>
    </style>

    <!-- A small heading over a value, such as YOUR ROOM CODE. -->
    <style name="TextAppearance.Pix.Overline" parent="TextAppearance.Pix.Caption">
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.Pix.Code" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:fontFamily">@font/dm_mono_medium</item>
        <item name="fontFamily">@font/dm_mono_medium</item>
        <item name="android:textSize">56sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/pix_text</item>
    </style>

    <style name="TextAppearance.Pix.Code.Digit">
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- A TextView without its own text appearance. -->
    <style name="Widget.Pix.TextView" parent="Widget.MaterialComponents.TextView">
        <item name="android:textAppearance">@style/TextAppearance.Pix.Body</item>
    </style>

    <!-- Buttons. Primary is the one accent action of a screen; Secondary its way back. -->
    <style name="Widget.Pix.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/button_primary_background</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="iconTint">@color/button_primary_text</item>
        <item name="rippleColor">@color/pix_ripple_on_accent</item>
        <item name="android:textAppearance">@style/TextAppearance.Pix.Action</item>
    </style>

    <!-- A small button inside a row, such as Invite and Accept on Share my camera. -->
    <style name="Widget.Pix.Button.Small">
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Pix.Action.Small</item>
    </style>

    <style name="Widget.Pix.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/button_secondary_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/button_secondary_text</item>
        <item name="iconTint">@color/button_secondary_text</item>
        <item name="iconPadding">8dp</item>
        <item name="iconGravity">textStart</item>
        <item name="rippleColor">@color/pix_ripple_strong</item>
        <item name="android:textAppearance">@style/TextAppearance.Pix.Action</item>
    </style>

    <!-- An outlined button inside a row, such as Invite on Share my camera while invitations are not built (Iter2-P15). -->
    <style name="Widget.Pix.Button.Secondary.Small">
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Pix.Action.Small</item>
    </style>

    <style name="Widget.Pix.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textColor">@color/button_text_text</item>
        <item name="rippleColor">@color/pix_ripple</item>
        <item name="android:textAppearance">@style/TextAppearance.Pix.Action.Small</item>
    </style>

    <!-- A text button that starts a line of its own at the content's edge, with a small icon before its words, such as
         Back to Auto under Generate poses' field (FR-4.15): a sentence in the accent, a touch target high. -->
    <style name="Widget.Pix.Button.Text.Line">
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textColor">@color/pix_accent</item>
        <item name="android:textAppearance">@style/TextAppearance.Pix.Label</item>
        <item name="iconTint">@color/pix_accent</item>
        <item name="iconSize">16dp</item>
        <item name="iconPadding">6dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- A pill over the preview: 44 dp of glass inside a 48 dp touch target. -->
    <style name="Widget.Pix.Button.Text.Small">
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
    </style>

    <!-- The step's action at a screen's top right, such as Select on Pick a pose (#199): yellow text without a pill at
         rest (#204), faint while disabled, in the middle of the 56 dp header. Under a touch, a 32 dp pill as wide as
         the text and 12 dp around it, whose right edge lines up with the screen's content below; the touch area is at
         least 48 dp each way. Back is at the top left. -->
    <style name="Widget.Pix.Button.Header">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:insetTop">8dp</item>
        <item name="android:insetBottom">8dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:gravity">center</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/button_header_text</item>
        <item name="rippleColor">@color/pix_ripple</item>
        <item name="android:textAppearance">@style/TextAppearance.Pix.Action.Small</item>
    </style>

    <!-- The same action in the camera's 48 dp top bar, such as Use on the scene photo's review: in the middle of the bar,
         with the bar's 52 dp touch height, whose last 4 dp reach over the image's top edge. -->
    <style name="Widget.Pix.Button.Header.Camera">
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">8dp</item>
    </style>

    <!-- A friend's initial in a circle. -->
    <style name="Widget.Pix.Avatar" parent="">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_avatar</item>
        <item name="android:gravity">center</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:textAppearance">@style/TextAppearance.Pix.Header</item>
    </style>

    <!-- A pill in the camera screens' top bar, such as Shoot together: 36 dp of glass in the middle of the bar's 48 dp,
         with a 52 dp touch height whose last 4 dp reach over the image's top edge. -->
    <style name="Widget.Pix.Button.Glass" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">6dp</item>
        <item name="android:insetBottom">10dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">13dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="backgroundTint">@color/pix_glass</item>
        <item name="strokeColor">@color/pix_glass_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/button_secondary_text</item>
        <item name="iconTint">@color/button_secondary_text</item>
        <item name="iconSize">16dp</item>
        <item name="iconPadding">6dp</item>
        <item name="rippleColor">@color/pix_ripple_strong</item>
        <item name="android:textAppearance">@style/TextAppearance.Pix.Action.Small</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.Pix.Button.Glass.Danger">
        <item name="strokeColor">@color/pix_danger_stroke</item>
        <item name="android:textColor">@color/button_danger_text</item>
        <item name="iconTint">@color/button_danger_text</item>
    </style>

    <!-- An icon-only round button, such as Remove guide: a 40 dp shape in a 48 x 48 dp touch area. -->
    <style name="Widget.Pix.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <!-- 2 dp less than Material's, as the insets grew: at a large font a button stays as tall as before. -->
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">11dp</item>
        <item name="android:paddingEnd">11dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">18dp</item>
        <item name="iconTint">@color/button_secondary_text</item>
        <item name="rippleColor">@color/pix_ripple_strong</item>
    </style>

    <!-- An icon button over a photo or the camera's image, such as the ♥ on Pick a pose and the tip, Save guide, and
         guide-edit buttons beside the zoom readout: the round shape in glass, so it shows on any scene (#298). -->
    <style name="Widget.Pix.Button.Icon.OnPhoto">
        <item name="backgroundTint">@color/pix_glass</item>
        <item name="strokeColor">@color/pix_glass_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- An icon in the top bar, such as the camera menu's button and the camera switch: no shape at rest, and under a
         touch, or while its panel is open, the bar's 32 dp tall pill, as the ratio's, centered on the bar's line above
         its last 4 dp, which reach over the image's top edge. A TurningButton's pill and touch area are 50 dp wide. The padding is 0 above and
         below, or the insets would make the bar taller. -->
    <style name="Widget.Pix.Button.Icon.TopBar">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">@dimen/top_bar_pill_inset_top</item>
        <item name="android:insetBottom">@dimen/top_bar_pill_inset_bottom</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <!-- It has no text, but a button measures a line of it: in dp, the empty line fits the pill at any font, or at
             200 % it would make the button and the bar 2 dp taller. -->
        <item name="android:textSize" tools:ignore="SpUsage">12dp</item>
        <item name="android:paddingStart">13dp</item>
        <item name="android:paddingEnd">13dp</item>
        <item name="iconSize">16dp</item>
    </style>

    <!-- The top bar's aspect ratio: its label alone, the size of the top bar's other text, in a 50 x 52 dp touch area.
         Under a touch, or while the ratios are open, the bar's pill around the label, 50 x 32 dp as the icons' are, wider
         only for a label at a large font. -->
    <style name="Widget.Pix.Button.Text.TopBar">
        <item name="android:minWidth">50dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">@dimen/top_bar_pill_inset_top</item>
        <item name="android:insetBottom">@dimen/top_bar_pill_inset_bottom</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="backgroundTint">@color/camera_top_bar_button_background</item>
        <item name="android:textColor">@color/button_secondary_text</item>
        <item name="rippleColor">@color/pix_ripple_strong</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- A ratio in the ratios under the top bar (FR-1.13): a touch area as tall as the panel, sharing its width with the
         other ratios, around the ratio's shape. Selection is View.isSelected. -->
    <style name="Widget.Pix.AspectOption" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- The ratio's shape with its label inside, in its option's state; the size is the ratio's own. -->
    <style name="Widget.Pix.AspectOption.Shape" parent="">
        <item name="android:layout_gravity">center</item>
        <item name="android:background">@drawable/bg_aspect_option</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:gravity">center</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAppearance">@style/TextAppearance.Pix.Caption</item>
        <item name="android:fontFamily">@font/pix_semibold</item>
        <item name="fontFamily">@font/pix_semibold</item>
        <item name="android:textColor">@color/aspect_option</item>
        <item name="android:textSize">8sp</item>
    </style>

    <!-- An item of the camera menu under the top bar (FR-1.17): its icon over a one-word label, in a 48 dp wide, 64 dp
         tall touch area (NFR-16); both in the accent while what it sets is on (activated). -->
    <style name="Widget.Pix.CameraMenuOption" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.Pix.CameraMenuOption.Icon" parent="">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/camera_menu_option</item>
    </style>

    <!-- The item's label, 10 sp in the medium face, its letters a little narrower (textScaleX) and closer than the
         face's own, so it stays quiet under its icon; shrinking toward 8 dp only where a large font would not fit it on
         its line (#298). -->
    <style name="Widget.Pix.CameraMenuOption.Label" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:autoSizeMaxTextSize">10sp</item>
        <item name="android:autoSizeMinTextSize">8dp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:gravity">center</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAppearance">@style/TextAppearance.Pix.Caption</item>
        <item name="android:fontFamily">@font/pix_medium</item>
        <item name="fontFamily">@font/pix_medium</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textScaleX">0.94</item>
        <item name="android:textColor">@color/camera_menu_option</item>
    </style>

    <!-- One part of a switch, such as the library's filters or Thin / Normal / Thick; selection is View.isSelected.
         48 dp tall, the touch target of NFR-16 (#298). -->
    <style name="Widget.Pix.Button.Segment" parent="Widget.Material3.Button.TextButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/segment_background</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="rippleColor">@color/pix_ripple</item>
        <item name="android:textAppearance">@style/TextAppearance.Pix.Label.Bold</item>
    </style>

    <!-- The switch in a section's header, such as All / With <name> over the descriptions used before (FR-4.11): a 32 dp
         shape in a 48 dp touch area (#298), on bg_segment_track_small, whose track is inset to match. -->
    <style name="Widget.Pix.Button.Segment.Small">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">8dp</item>
        <item name="android:insetBottom">8dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Sliders: a thin track and a round thumb, like the zoom and opacity controls of a camera. -->
    <style name="Widget.Pix.Slider" parent="Widget.Material3.Slider">
        <item name="trackHeight">4dp</item>
        <item name="thumbWidth">20dp</item>
        <item name="thumbHeight">20dp</item>
        <item name="thumbTrackGapSize">0dp</item>
        <item name="trackStopIndicatorSize">0dp</item>
        <item name="trackInsideCornerSize">2dp</item>
        <item name="thumbColor">@color/slider_thumb</item>
        <item name="trackColorActive">@color/slider_track_active</item>
        <item name="trackColorInactive">@color/pix_track</item>
        <item name="haloColor">@color/pix_accent_soft</item>
        <item name="haloRadius">18dp</item>
        <item name="tickVisible">false</item>
        <item name="labelStyle">@style/Widget.Pix.Slider.Label</item>
    </style>

    <!-- The guide's own controls use the guide color. -->
    <style name="Widget.Pix.Slider.Guide">
        <item name="trackColorActive">@color/slider_guide_track_active</item>
        <item name="haloColor">@color/pix_guide_soft</item>
    </style>

    <style name="Widget.Pix.Slider.Label" parent="Widget.Material3.Slider.Label">
        <item name="backgroundTint">@color/pix_surface_3</item>
        <item name="android:textColor">@color/pix_text</item>
    </style>

    <!-- Status chips over the preview. -->
    <style name="Widget.Pix.Chip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:background">@drawable/bg_chip_glass</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Pix.Label</item>
    </style>

    <!-- "Live · <name> connected" (FR-6.8) and "<name>'s camera". -->
    <!-- A chip over the camera's image, the size of the top bar's pills: hints, notices, and what just happened. -->
    <style name="Widget.Pix.Chip.Small">
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">11dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:drawablePadding">5dp</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Widget.Pix.Header.Back" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginStart">-12dp</item>
        <item name="android:background">@drawable/bg_header_icon</item>
        <item name="android:src">@drawable/ic_arrow_back</item>
        <item name="android:contentDescription">@string/back</item>
        <item name="tint">@color/pix_text</item>
    </style>


    <!-- An item of a menu card that a header's ⋮ opens (bg_menu_card, the library's, #297): a row 48 dp tall
         (NFR-16) of body text in the text color, its light rounded inside the card. -->
    <style name="Widget.Pix.MenuItem" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:background">@drawable/bg_menu_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textAppearance">@style/TextAppearance.Pix.BodyLarge</item>
        <item name="android:textColor">@color/pix_text</item>
    </style>

    <!-- The chevron at the end of a row or card that a tap opens (#204). Its tip is drawn 8 dp inside its 24 dp box,
         so after the row's 8 dp end padding it is 16 dp from the edge on every screen, as far as Settings' text is
         from the other edge. -->
    <style name="Widget.Pix.Chevron" parent="">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:src">@drawable/ic_chevron_right</item>
        <item name="tint">@color/pix_text_faint</item>
    </style>

    <!-- One box of the 6-digit room code (R&S 6.7). Six of them fit a 360 dp wide phone. -->
    <style name="Widget.Pix.CodeDigit" parent="">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:background">@drawable/bg_code_digit</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">@style/TextAppearance.Pix.Code.Digit</item>
    </style>

    <!-- A Generating poses / Pick a pose candidate. -->
    <!-- A text field, such as the pose description on Generate poses (FR-4.8). -->
    <style name="Widget.Pix.TextField" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_text_field</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Pix.BodyLarge</item>
        <item name="android:textColor">@color/pix_text</item>
        <item name="android:textColorHint">@color/pix_text_faint</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>

    <!-- A description used before, on Generate poses (FR-4.11): it fills the description field when tapped, and its
         ✕ removes it from the history. -->
    <style name="Widget.Pix.HistoryChip" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipBackgroundColor">@color/pix_surface_2</item>
        <item name="chipStrokeColor">@color/pix_outline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Pix.Label</item>
        <item name="android:textColor">@color/pix_text_soft</item>
        <item name="rippleColor">@color/pix_ripple</item>
        <item name="closeIconVisible">true</item>
        <item name="closeIcon">@drawable/ic_close</item>
        <item name="closeIconTint">@color/pix_text_muted</item>
        <item name="closeIconSize">16dp</item>
    </style>

    <!-- An option of Generate poses (FR-4.15): a tap writes its words into the description, and it is checked, in the
         accent, while they are there. No check mark: the color says it. -->
    <style name="Widget.Pix.OptionChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/option_chip_background</item>
        <item name="chipStrokeColor">@color/option_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Pix.Label</item>
        <item name="android:textColor">@color/option_chip_text</item>
        <item name="rippleColor">@color/pix_ripple</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
    </style>

    <style name="Widget.Pix.PoseCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/pix_surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/pose_card_stroke</item>
        <item name="rippleColor">@color/pix_ripple</item>
    </style>

    <style name="Widget.Pix.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/pix_surface</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Sheets and dialogs. -->
    <style name="ShapeAppearance.Pix.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ShapeAppearance.Pix.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearance.Pix.Thumbnail" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Matches Widget.Pix.PoseCard, so the image follows the card's corners. -->
    <style name="ShapeAppearance.Pix.PoseImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- A large image of its own, such as a candidate on Pick a pose: the corners of Widget.Pix.Card. -->
    <style name="ShapeAppearance.Pix.LargeImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- The saved guides at the end of My library's row on Add a pose guide (FR-3.11). -->
    <style name="ShapeAppearance.Pix.TinyThumbnail" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.Pix.SmallThumbnail" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Widget.Pix.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/pix_surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Pix.Sheet</item>
    </style>

    <style name="Widget.Pix.BottomSheet.DragHandle" parent="Widget.Material3.BottomSheet.DragHandle">
        <item name="tint">@color/pix_handle</item>
    </style>

    <!-- 18 sp, which Android's dialog title takes by itself when a title does not fit on one line at a larger size: every
         dialog's title is that size, long or short. -->
    <style name="MaterialAlertDialog.Pix.Title.Text" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textAppearance">@style/TextAppearance.Pix.SheetTitle</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="MaterialAlertDialog.Pix.Body.Text" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textAppearance">@style/TextAppearance.Pix.Body</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <!-- Material's 12 dp set again as start and end: the theme's materialButtonStyle gives every button 20 dp there,
         which would win over the left and right of Material's dialog style. -->
    <style name="Widget.Pix.Button.Dialog" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/button_text_text</item>
        <item name="android:textAppearance">@style/TextAppearance.Pix.Action.Small</item>
    </style>

    <style name="Widget.Pix.Button.Dialog.Positive">
        <item name="android:textColor">@color/pix_accent</item>
    </style>

    <!-- A short notice (#298): a Snackbar, not a Toast, placed by ui/Notices.kt. An info card's 16 dp corners on
         pix_surface_3, so it stands out from the ground and from the glass over the camera's image, with its action,
         such as Undo, in the accent, as every act is. -->
    <style name="Widget.Pix.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">@color/pix_surface_3</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Pix.Notice</item>
        <item name="android:layout_margin">12dp</item>
    </style>

    <!-- Up to four lines, so a notice says all a Toast did. -->
    <style name="Widget.Pix.Snackbar.TextView" parent="Widget.Material3.Snackbar.TextView">
        <item name="android:textColor">@color/pix_text</item>
        <item name="android:maxLines">4</item>
    </style>

    <!-- Start and end set again, as for Widget.Pix.Button.Dialog. -->
    <style name="Widget.Pix.Snackbar.Action" parent="Widget.Material3.Button.TextButton.Snackbar">
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/pix_accent</item>
        <item name="android:textAppearance">@style/TextAppearance.Pix.Action.Small</item>
    </style>

    <style name="ShapeAppearance.Pix.Notice" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
</resources>
