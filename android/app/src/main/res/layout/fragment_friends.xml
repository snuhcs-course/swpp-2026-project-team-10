<?xml version="1.0" encoding="utf-8"?>
<!-- Share my camera, the photographer's ways to connect (R&S 6.4, 6.7; FR-5.4, FR-5.7, FR-5.9, FR-5.16, FR-8.1): the
     Pix friends to invite scroll, and Show a code stays at the bottom, signed in or not. Signed out, the friends give
     way to Sign in; a Google account without a Pix ID is asked to choose one first. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp">

        <ImageButton
            android:id="@+id/backButton"
            style="@style/Widget.Pix.Header.Back"
            android:contentDescription="@string/back_to_camera" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/share_my_camera"
            android:textAppearance="@style/TextAppearance.Pix.Header" />

        <!-- Add a friend by Pix ID (FR-5.5), once the account has one. -->
        <ImageButton
            android:id="@+id/addFriendButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/add_a_friend"
            android:src="@drawable/ic_person_add"
            android:visibility="gone"
            app:tint="@color/pix_text"
            tools:visibility="visible" />

        <!-- The Account sheet (decided in Iter2-P13): name, Add Google or Add a password, Sign out. -->
        <ImageButton
            android:id="@+id/accountButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="-12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/account"
            android:src="@drawable/ic_account"
            android:visibility="gone"
            app:tint="@color/pix_text"
            tools:visibility="visible" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/invite_pix_friend"
                android:textAppearance="@style/TextAppearance.Pix.Action"
                android:textColor="@color/pix_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/invite_pix_friend_body"
                android:textAppearance="@style/TextAppearance.Pix.Body.Small" />

            <!-- The last refresh failed; the lists are what was loaded before. -->
            <TextView
                android:id="@+id/offlineText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/friends_offline"
                android:textAppearance="@style/TextAppearance.Pix.Body.Small"
                android:textColor="@color/pix_danger_text"
                android:visibility="gone" />

            <!-- Signed out, or no Pix ID yet: one card in place of the friends, with its button. -->
            <LinearLayout
                android:id="@+id/promptCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_info_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="20dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_icon_tile"
                    android:importantForAccessibility="no"
                    android:padding="14dp"
                    android:src="@drawable/ic_people"
                    app:tint="@color/pix_text_muted" />

                <!-- Only for the Pix ID: signed out, the section's title says what the card is for. -->
                <TextView
                    android:id="@+id/promptTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Pix.Action"
                    android:textColor="@color/pix_text"
                    android:visibility="gone"
                    tools:text="@string/choose_pix_id_title" />

                <TextView
                    android:id="@+id/promptBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.2"
                    android:textAppearance="@style/TextAppearance.Pix.Body"
                    tools:text="@string/signed_out_body" />

                <Button
                    android:id="@+id/signInButton"
                    style="@style/Widget.Pix.Button.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/sign_in_to_add_friends"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <Button
                    android:id="@+id/choosePixIdButton"
                    style="@style/Widget.Pix.Button.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/choose_pix_id"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Received requests with Accept and Decline (FR-5.7). -->
            <TextView
                android:id="@+id/requestsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="2dp"
                android:text="@string/friend_requests"
                android:textAppearance="@style/TextAppearance.Pix.Overline"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/requestsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Requests the user sent and nobody answered yet, which Sent requests lists with Withdraw (FR-5.16). -->
            <Button
                android:id="@+id/sentRequestsButton"
                style="@style/Widget.Pix.Button.Text.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="-12dp"
                android:visibility="gone"
                app:icon="@drawable/ic_chevron_right"
                app:iconGravity="end"
                app:iconPadding="2dp"
                app:iconSize="18dp"
                app:iconTint="@color/button_text_text"
                tools:text="Sent requests · 2"
                tools:visibility="visible" />

            <!-- No friends yet. -->
            <LinearLayout
                android:id="@+id/emptyCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_info_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="28dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_people"
                    app:tint="@color/pix_text_faint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/no_friends_title"
                    android:textAppearance="@style/TextAppearance.Pix.Action.Small"
                    android:textColor="@color/pix_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/no_friends_body"
                    android:textAppearance="@style/TextAppearance.Pix.Body.Small" />
            </LinearLayout>

            <!-- Friends with name, online status, and Invite (FR-5.9); long-press to remove (FR-5.10). -->
            <LinearLayout
                android:id="@+id/friendsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <!-- Someone beside the photographer, Pix friend or not and signed in or not (FR-5.1, FR-8.1). #122 adds Show a
         QR code under Show a code. -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:accessibilityHeading="true"
        android:text="@string/connect_nearby"
        android:textAppearance="@style/TextAppearance.Pix.Action"
        android:textColor="@color/pix_text" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/connect_nearby_body"
        android:textAppearance="@style/TextAppearance.Pix.Body.Small" />

    <LinearLayout
        android:id="@+id/showCodeButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_option_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:paddingVertical="12dp"
        android:paddingStart="14dp"
        android:paddingEnd="8dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_tile">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_code"
                app:tint="@color/pix_accent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/show_code"
                android:textAppearance="@style/TextAppearance.Pix.Action.Small"
                android:textColor="@color/pix_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/show_code_body"
                android:textAppearance="@style/TextAppearance.Pix.Body.Small" />
        </LinearLayout>

        <!-- 8 dp end padding before it, as on every row a tap opens (Widget.Pix.Chevron). -->
        <ImageView
            android:id="@+id/showCodeChevron"
            style="@style/Widget.Pix.Chevron"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Tap to copy (FR-5.4). -->
    <TextView
        android:id="@+id/myPixIdText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:minHeight="44dp"
        android:paddingHorizontal="12dp"
        android:textAppearance="@style/TextAppearance.Pix.Label"
        android:textColor="@color/pix_text_muted"
        android:visibility="gone"
        tools:text="My Pix ID: test1" />
</LinearLayout>
