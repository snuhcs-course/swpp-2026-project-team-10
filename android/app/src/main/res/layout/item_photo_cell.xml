<?xml version="1.0" encoding="utf-8"?>
<!-- One photo of Pix's album in the viewer's grid (view_photo_viewer, FR-1.6): a square of it, cut from its middle, with
     1 dp around it, so the grid's photos lie 2 dp apart; the surface's color until it is read. A tap opens its page. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:padding="1dp">

    <ImageView
        android:id="@+id/photoCellImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/pix_surface_2"
        android:foreground="?attr/selectableItemBackground"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
