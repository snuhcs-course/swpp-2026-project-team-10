# On a course server this file is /opt/pix/.env, created by deploy/setup.sh and read by both copies of the app;
# run `deploy.sh restart` after changing it. Locally, copy it to server/.env.
#
# A name with no value (`NAME=`) must be set on every server: deploy.sh warns while /opt/pix/.env lacks a value for
# it, and never writes the file. Every other name is commented: it shows the app's default, or is set elsewhere, as
# its comment says. Uncomment one only to give a server another value, so a default changed in the code still
# reaches every server. Add every new setting here; a test checks that this file lists them all.

# Required for pose generation; signaling works without it. Never commit the real key.
OPENROUTER_API_KEY=

# The web client ID that the app passes to Google sign-in. Without it, Google sign-in answers UNAVAILABLE.
PIX_GOOGLE_CLIENT_ID=

# The TURN key of Cloudflare Realtime (dashboard: Realtime, TURN Server): its id and API token. Without them each phone
# gets a STUN server only, and sessions across networks often fail to connect. Never commit the real token.
PIX_TURN_KEY_ID=
PIX_TURN_API_TOKEN=

# The session store (Design 2.7). On a course server deploy/docker-compose.yml sets it, so leave it out there.
# Locally, leave it out to keep rooms inside the one server process, or point it at a Redis of your own.
# PIX_REDIS_URL=redis://localhost:6379/0

# The account database (Design 2.7). On a course server deploy/docker-compose.yml sets it, so leave it out there.
# Locally, leave it out to keep the accounts in pix.db, a SQLite file in server/, or point it at a PostgreSQL.
# PIX_DATABASE_URL=postgresql+asyncpg://pix:pix@localhost:5432/pix

# The key file of the service account that sends push notifications through Firebase Cloud Messaging (Design 2.6.6).
# On a course server deploy/docker-compose.yml sets the path inside the container, so leave it out there and put the
# file at /opt/pix/secrets/fcm-sender.json (README, Push notifications). Locally, point it at the file, kept outside the
# repository. Without it, invitations and friend requests send no push; the invite link still works.
# PIX_FCM_CREDENTIALS_FILE=/path/outside/the/repository/fcm-sender.json

# Signs access tokens (JWT). On a course server deploy.sh makes it, so leave it out there. Locally, leave it out to
# make a new one each start, which ends every access token on a restart, or set any random text of 32 bytes or more.
# PIX_JWT_SECRET=

# Defaults; uncomment one only to change it.
# PIX_ACCESS_TOKEN_MINUTES=15
# PIX_SESSION_TTL_DAYS=30
# PIX_ROOM_TTL_SECONDS=600
# PIX_EMPTY_SESSION_TTL_SECONDS=60
# PIX_CLEANUP_INTERVAL_SECONDS=1
# PIX_MAX_MESSAGE_BYTES=65536
# PIX_OUTBOUND_QUEUE_SIZE=128
# PIX_SEND_TIMEOUT_SECONDS=5
# PIX_WORKER_TTL_SECONDS=15
# PIX_POSE_MODEL=openai/gpt-image-2.5-flare@low
# PIX_POSE_UPSTREAM_TIMEOUT_SECONDS=60
# PIX_POSE_RATE_LIMIT=20
# PIX_POSE_RATE_WINDOW_SECONDS=3600
# PIX_POSE_GLOBAL_LIMIT=500
# PIX_POSE_GLOBAL_WINDOW_SECONDS=86400
# PIX_SUGGESTION_MODEL=google/gemini-3.1-flash-lite
# PIX_SUGGESTION_TIMEOUT_SECONDS=8
# PIX_SUGGESTION_RATE_LIMIT=10
# PIX_SUGGESTION_GLOBAL_LIMIT=500
# PIX_TIP_MODEL=google/gemini-3.1-flash-lite
# PIX_TIP_REASONING=low
# PIX_TIP_TIMEOUT_SECONDS=10
# PIX_TIP_RATE_LIMIT=20
# PIX_TIP_GLOBAL_LIMIT=1000
# PIX_JOIN_FAILURE_LIMIT=100
# PIX_JOIN_FAILURE_WINDOW_SECONDS=600
# PIX_TURN_TTL_SECONDS=14400
# PIX_TURN_TIMEOUT_SECONDS=3
# PIX_INVITATION_TTL_SECONDS=60
# PIX_INVITATION_JOIN_SECONDS=15
# PIX_FCM_TIMEOUT_SECONDS=5
