<?xml version="1.0" encoding="utf-8"?>
<!-- A step of the pose flow coming forward (#210): it fades in over the last step, which stays under it, so
     the header the two share, Back and the flow's bar, stays where it is. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="@integer/screen_transition_ms"
    android:interpolator="@android:interpolator/fast_out_slow_in"
    android:propertyName="alpha"
    android:valueFrom="0"
    android:valueTo="1"
    android:valueType="floatType" />
