<?xml version="1.0" encoding="utf-8"?>
<!-- Subject view (R&S 6.6, FR-6.6, FR-6.7, FR-7.1–7.3). No shutter: only the photographer takes photos. A pinch on
     the video zooms the photographer's camera while guide-edit mode is off (AD-17); with it on, drags and pinches
     move the photographer's guide. The brightness slider and the flash button are the photographer's controls. The
     video is placed as on the Camera screen (previewArea, in code), and the zoom row and the caption lie above it. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:outlineProvider="none"
        android:paddingHorizontal="10dp"
        android:paddingVertical="0dp"
        android:translationZ="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- The photographer's flash, cycled from here (FR-7.3); hidden when their phone has none. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/flashButton"
            style="@style/Widget.Pix.Button.Icon.TopBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/flash_off"
            android:visibility="gone"
            app:icon="@drawable/ic_flash_off"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <Button
            android:id="@+id/leaveButton"
            style="@style/Widget.Pix.Button.Glass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/leave"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="44dp"
        android:layout_marginBottom="44dp"
        android:background="@color/pix_ground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- The photographer's live video, the whole frame in the ratio they chose (Design 2.6.4, AD-10). It wraps
             its content so that it measures itself to the video's shape and is centered, the same rectangle the
             grid and the guide fit; at match_parent the renderer would crop every frame to the view's shape. -->
        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/liveView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <!-- The same 3×3 grid as the photographer's preview, over the same fitted image; no level bar here. -->
        <com.lastpenguin.pix.ui.camera.CameraCompositionView
            android:id="@+id/compositionOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <!-- "Connecting…" until the peer connection is up, or "camera paused" when frames stop. -->
        <TextView
            android:id="@+id/connectingText"
            style="@style/Widget.Pix.Chip.Small"
            android:layout_gravity="center"
            android:accessibilityLiveRegion="polite"
            android:text="@string/connecting" />

        <!-- The synced guide (#9). Editable only while guide-edit mode is on; moving it is #57. -->
        <com.lastpenguin.pix.guide.GuideOverlayView
            android:id="@+id/guideOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- The photographer's reference photo (FR-3.9), as on their Camera screen: a tap enlarges it, a drag moves it
             to another corner of this phone's video. Sized and placed in code; over the guide, so it takes its touches. -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/referenceThumbnail"
            android:layout_width="54dp"
            android:layout_height="72dp"
            android:layout_gravity="top|left"
            android:background="@color/pix_ground"
            android:contentDescription="@string/reference_photo"
            android:padding="0.5dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Pix.SmallThumbnail"
            app:strokeColor="@color/pix_glass_stroke"
            app:strokeWidth="1dp"
            tools:ignore="RtlHardcoded"
            tools:visibility="visible" />

        <!-- The photographer's camera is streaming (FR-6.6, FR-6.8): the light at the video's top right, placed in code;
             its description names the photographer. -->
        <com.lastpenguin.pix.ui.camera.LiveDotView
            android:id="@+id/liveDot"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="top|left"
            android:accessibilityLiveRegion="polite"
            android:importantForAccessibility="yes"
            android:visibility="gone"
            tools:ignore="RtlHardcoded"
            tools:visibility="visible" />
    </FrameLayout>

    <!-- Right above the caption, as the Camera screen's panels sit above its shutter: the photographer's brightness
         (FR-7.3), opened from the button beside the readout; the value is in EV. -->
    <LinearLayout
        android:id="@+id/bottomOverlays"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:outlineProvider="none"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp"
        android:translationZ="1dp"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/brightnessPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_glass_panel"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_brightness"
                app:tint="@color/pix_text_soft" />

            <com.google.android.material.slider.Slider
                android:id="@+id/brightnessSlider"
                style="@style/Widget.Pix.Slider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:contentDescription="@string/brightness"
                android:enabled="false"
                android:value="1"
                android:valueFrom="1"
                android:valueTo="2" />

            <TextView
                android:id="@+id/brightnessValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:importantForAccessibility="no"
                android:minWidth="40dp"
                android:textAppearance="@style/TextAppearance.Pix.Label.Bold"
                tools:text="+0.7" />
        </LinearLayout>
    </LinearLayout>

    <!-- The Camera screen's row: brightness button, zoom readout (FR-7.1), and the guide-edit mode toggle, over the
         bottom of the video (placed in code). -->
    <FrameLayout
        android:id="@+id/zoomRow"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:outlineProvider="none"
        android:paddingHorizontal="12dp"
        android:translationZ="1dp"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Opens the brightness slider above (FR-7.3); checked while it is open. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/brightnessButton"
            style="@style/Widget.Pix.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:checkable="true"
            android:contentDescription="@string/brightness"
            android:visibility="gone"
            app:backgroundTint="@color/brightness_button_background"
            app:icon="@drawable/ic_brightness"
            app:iconTint="@color/brightness_button_icon"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/zoomReadout"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@drawable/bg_zoom_readout"
            android:focusable="true"
            android:gravity="center"
            android:importantForAccessibility="yes"
            android:minWidth="48dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:textAppearance="@style/TextAppearance.Pix.Label.Bold"
            android:textColor="@color/zoom_readout_text"
            android:textSize="11sp"
            tools:text="1.0×" />

        <!-- Shown while a guide is on the video (AD-17); checked while gestures edit the guide. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/editGuideButton"
            style="@style/Widget.Pix.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:layout_gravity="end|center_vertical"
            android:contentDescription="@string/edit_guide"
            android:visibility="gone"
            app:backgroundTint="@color/edit_guide_background"
            app:icon="@drawable/ic_move"
            app:iconTint="@color/edit_guide_icon"
            tools:visibility="visible" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:outlineProvider="none"
        android:translationZ="1dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            app:drawableStartCompat="@drawable/ic_zoom_small"
            android:drawablePadding="8dp"
            app:drawableTint="@color/pix_text_muted"
            android:gravity="center"
            android:text="@string/subject_caption"
            android:textAppearance="@style/TextAppearance.Pix.Body.Small"
            android:textColor="@color/pix_text_soft" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
