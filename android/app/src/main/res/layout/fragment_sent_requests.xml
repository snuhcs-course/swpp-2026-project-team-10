<?xml version="1.0" encoding="utf-8"?>
<!-- Sent requests, from "Sent requests · 2" on Friends (R&S 6.4; FR-5.16): each request the user sent that nobody
     answered yet, with Withdraw. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp">

        <ImageButton
            android:id="@+id/backButton"
            style="@style/Widget.Pix.Header.Back"
            android:contentDescription="@string/back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/sent_requests_title"
                android:textAppearance="@style/TextAppearance.Pix.Header" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/sent_requests_subtitle"
                android:textAppearance="@style/TextAppearance.Pix.Body.Small" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- The last refresh failed; the list is what was loaded before. -->
            <TextView
                android:id="@+id/offlineText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/friends_offline"
                android:textAppearance="@style/TextAppearance.Pix.Body.Small"
                android:textColor="@color/pix_danger_text"
                android:visibility="gone" />

            <!-- Every request was answered or withdrawn. -->
            <LinearLayout
                android:id="@+id/emptyCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_info_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="36dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_people"
                    app:tint="@color/pix_text_faint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/no_sent_requests_title"
                    android:textAppearance="@style/TextAppearance.Pix.Action.Small"
                    android:textColor="@color/pix_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/no_sent_requests_body"
                    android:textAppearance="@style/TextAppearance.Pix.Body.Small" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sentList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
