<?xml version="1.0" encoding="utf-8"?>
<!-- Over a situation's tile on Add a pose guide (FR-4.8): the press, and the chosen one's accent edge. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/pix_ripple_strong">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/pix_text" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/pix_accent" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/pix_hairline" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
