<?xml version="1.0" encoding="utf-8"?>
<!-- A text field: the card surface with an outline that turns to the accent while it has focus, and to the accent's
     tint while it is activated: Generate poses' field while it says Auto, the value it stands on (FR-4.15). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/pix_surface_2" />
            <stroke android:width="1.5dp" android:color="@color/pix_accent" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/pix_surface_2" />
            <stroke android:width="1dp" android:color="@color/pix_accent_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/pix_surface_2" />
            <stroke android:width="1dp" android:color="@color/pix_outline" />
        </shape>
    </item>
</selector>
