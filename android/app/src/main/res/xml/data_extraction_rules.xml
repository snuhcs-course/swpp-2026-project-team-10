<?xml version="1.0" encoding="utf-8"?>
<!-- The sign-in never leaves the phone (Design 2.8, Accounts): a copied refresh token would be spent twice, which
     ends the session on both phones. Cloud backups are off (allowBackup="false"); from Android 12 that does not stop a
     transfer to a new phone, which these rules govern. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/account.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/account.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
