<?xml version="1.0" encoding="utf-8"?>
<!-- Reference confirm (R&S 6.2). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp">

        <ImageButton
            android:id="@+id/backButton"
            style="@style/Widget.Pix.Header.Back"
            android:contentDescription="@string/back" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/reference_title"
                android:textAppearance="@style/TextAppearance.Pix.Header" />

            <!-- "Junhyeong chose this pose" when the subject's pick brought the candidate here (FR-6.15). -->
            <TextView
                android:id="@+id/chosenByText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Pix.Body.Small"
                android:visibility="gone"
                tools:text="Junhyeong chose this pose"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>

    <!-- The outline over a neutral background (FR-2.3). Dark, so the light stroke stands out as it does on the camera. -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Pix.Card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/referenceImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/reference_preview_description"
                android:padding="20dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/referenceProgress"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/pix_accent"
                android:visibility="gone" />

            <!-- "Finding the person…" or "Person found". -->
            <TextView
                android:id="@+id/referenceStatus"
                style="@style/Widget.Pix.Chip"
                android:layout_gravity="top|start"
                android:layout_margin="14dp"
                android:accessibilityLiveRegion="polite"
                app:drawableTint="@color/pix_live"
                android:text="@string/finding_person"
                android:textColor="@color/pix_text"
                android:visibility="invisible"
                tools:drawableStartCompat="@drawable/ic_person_check_small"
                tools:visibility="visible" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <Button
        android:id="@+id/useGuideButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:enabled="false"
        android:text="@string/use_this_guide" />

    <Button
        android:id="@+id/chooseAnotherButton"
        style="@style/Widget.Pix.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/choose_another_photo" />
</LinearLayout>
