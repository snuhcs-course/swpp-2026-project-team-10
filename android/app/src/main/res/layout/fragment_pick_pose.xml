<?xml version="1.0" encoding="utf-8"?>
<!-- Pick a pose (R&S 6.3), and the subject's (R&S 6.6): Back at the top left, Select at the top right (#199). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp">

        <ImageButton
            android:id="@+id/backButton"
            style="@style/Widget.Pix.Header.Back"
            android:contentDescription="@string/back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/pick_pose_title"
            android:textAppearance="@style/TextAppearance.Pix.Header" />

        <!-- Takes the pose on screen to Reference confirm. -->
        <Button
            android:id="@+id/selectButton"
            style="@style/Widget.Pix.Button.Header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/select_pose" />
    </LinearLayout>

    <!--
        The candidates one at a time, as large as the screen allows; a swipe shows the next. The pose on screen is the
        selected one, and its neighbors show at the sides. Reaches the screen's edges, past this layout's padding.
    -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/candidatePager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="-20dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        tools:listitem="@layout/item_pose_page" />

    <TextView
        android:id="@+id/pageCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:textAppearance="@style/TextAppearance.Pix.Label.Bold"
        android:textColor="@color/pix_text_faint"
        tools:text="1 / 4" />

    <!-- In a session: the subject sees these candidates too, and the first choice decides (FR-6.15). -->
    <TextView
        android:id="@+id/sharedHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Pix.Body.Small"
        android:visibility="gone"
        tools:text="Joonhyung sees this too"
        tools:visibility="visible" />

    <!-- A new set from the same description, or new suggestions, outside a session only (#199). -->
    <Button
        android:id="@+id/regenerateButton"
        style="@style/Widget.Pix.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/regenerate_poses"
        android:visibility="gone"
        app:icon="@drawable/ic_refresh"
        app:iconSize="18dp"
        tools:visibility="visible" />
</LinearLayout>
