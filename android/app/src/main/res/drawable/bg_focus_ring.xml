<?xml version="1.0" encoding="utf-8"?>
<!-- Where a tap on the preview focuses (FR-1.4): a thin square in the accent with a short tick at the middle of each
     side, like the applied zoom; the brightness bar stands beside it (Design 2.8). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/pix_accent" />
        </shape>
    </item>
    <item
        android:width="1dp"
        android:height="5dp"
        android:gravity="top|center_horizontal">
        <shape android:shape="rectangle">
            <solid android:color="@color/pix_accent" />
        </shape>
    </item>
    <item
        android:width="1dp"
        android:height="5dp"
        android:gravity="bottom|center_horizontal">
        <shape android:shape="rectangle">
            <solid android:color="@color/pix_accent" />
        </shape>
    </item>
    <item
        android:width="5dp"
        android:height="1dp"
        android:gravity="start|center_vertical">
        <shape android:shape="rectangle">
            <solid android:color="@color/pix_accent" />
        </shape>
    </item>
    <item
        android:width="5dp"
        android:height="1dp"
        android:gravity="end|center_vertical">
        <shape android:shape="rectangle">
            <solid android:color="@color/pix_accent" />
        </shape>
    </item>
</layer-list>
