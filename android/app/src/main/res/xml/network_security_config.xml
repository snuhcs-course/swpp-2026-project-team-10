<?xml version="1.0" encoding="utf-8"?>
<!--
    Release builds use the AWS main server over HTTPS (Design 2.8, Configuration and secrets), so they allow no plain
    http:// or ws:// to any host. Debug builds replace this file with src/debug/res/xml/.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
