<?xml version="1.0" encoding="utf-8"?>
<!-- One box of the 6-digit room code; the next box to fill is activated (R&S 6.7). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/pix_surface" />
            <stroke android:width="1.5dp" android:color="@color/pix_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/pix_surface" />
            <stroke android:width="1dp" android:color="@color/pix_outline" />
        </shape>
    </item>
</selector>
